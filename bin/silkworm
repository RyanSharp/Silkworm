#!/usr/bin/env python3
"""Silkworm CLI — start tracked sessions and manage the install.

    silkworm [title] [--dir PATH]   start a tracked Claude session here
                                    (a title starting with a subcommand needs --dir .
                                    first, e.g. silkworm --dir . land the parser fix)
    silkworm import                 adopt running claude sessions into Silkworm
    silkworm harvest                run the learning harvester now
    silkworm summarize [--force]    (re)generate thread context summaries
    silkworm titles [--force]       name threads from their summaries
    silkworm tasks [state]          list tasks (default: what needs you)
    silkworm email                  scan Gmail now and propose tasks
    silkworm defer <delay> <goal>   schedule a later turn (from inside a turn)
    silkworm task <goal>            file scoped work as a task (from inside a turn)
    silkworm watching               scheduled wake-ups and when they fire
    silkworm status --json          the board, branches, revision, drain and wake-ups, as JSON
    silkworm accept <id>            queue a proposal               } the dashboard's
    silkworm dismiss <id> [--round R]  cancel it                   } buttons, through
    silkworm land <id>              land a finished task's branch  } the same handlers:
    silkworm drop <id>              delete it, tagging its tip     } a refusal prints
    silkworm edit <id> [--goal G] [--title T]  change unrun work   } the bot's reason
    silkworm rework <id> --notes N  send back with your notes      } and exits 1
    silkworm close <id> [--round R] close research findings        }
    silkworm dig <id> --notes N [--round R]  research: dig deeper  }
    silkworm retry <id> / run-next <id>   requeue failed work / put it first
    silkworm tidy <checkout path>   remove a finished checkout holding only generated files
    silkworm operator notes [--set T] | contained <id> | approvals | git …   the operator's own
    silkworm discard <branch>...    delete task branches, keeping their tips
    silkworm artifacts [--days N]   what artifacts/ retention would remove (removes nothing)
    silkworm learnings sync         commit/pull/push shared learnings via git
    silkworm learnings init [remote]  make the learnings dir a git repo for sharing
    silkworm setup                  first-run bootstrap: deps, hooks, services
    silkworm install | uninstall    (un)install the login services (bot + visualizer)
    silkworm status                 health check: services, bot, visualizer, hooks
    silkworm restart                restart the services
    silkworm tailscale [status|on|off]  serve the dashboard to your tailnet (never Funnel)
    silkworm deploy [--now] [--skip-tests] [--max-wait 2h]
                                    restart onto this checkout without killing work
    silkworm deploy --after-turn [--skip-tests] [--max-wait 2h]
                                    the same from inside a turn: checks now, then a
                                    detached process deploys once the turn has ended
    silkworm logs                   tail the bot log
    silkworm doctor                 check prerequisites
    silkworm test                   run the regression tests

The action commands (accept … dig) and `status --json` are a stable interface
for scripts and agents: exit 0 on success with one line, 1 when the bot refuses
(its reason on stderr), 2 on a usage error, 3 when the bot cannot be reached.
Each accepts --by NAME (default "cli") for the task's event log.

Runs on macOS today (launchd LaunchAgents); Linux (systemd user units) planned —
the ServiceManager below is the only platform-specific part. Stdlib only.
"""

import json
import os
import shutil
import socket
import subprocess
import sys
import time
import urllib.request
import uuid
from pathlib import Path

REPO = Path(__file__).resolve().parent.parent
VENV_PY = REPO / ".venv" / "bin" / "python"
LOGS = REPO / "logs"

Y = "\033[33m"; G = "\033[32m"; R = "\033[31m"; N = "\033[0m"
WORM = f"{Y}🪱 silkworm:{N}"


def env_file_value(name: str):
    """What .env sets `name` to, or None if it doesn't -- read as python-dotenv
    (the bot's reader) does, so a .env the bot obeys can't send the CLI
    elsewhere. See envfile.value."""
    return envfile.value(REPO / ".env", name)


def bot_port() -> str:
    # SILKWORM_BOT_PORT first, as SILKWORM_VIZ_PORT is for the visualizer: it
    # is how the tests point the action commands at a stand-in bot.
    return os.environ.get("SILKWORM_BOT_PORT") or env_file_value("APPROVAL_PORT") or "8787"


def viz_port() -> str:
    return os.environ.get("SILKWORM_VIZ_PORT", "8790")


DEFAULT_LEARNINGS = REPO / "learnings.json"


def learnings_file() -> Path:
    val = env_file_value("LEARNINGS_FILE")
    return Path(val).expanduser() if val else DEFAULT_LEARNINGS


def bot_call(path: str, payload: dict, timeout: float = 3) -> dict:
    req = urllib.request.Request(
        f"http://127.0.0.1:{bot_port()}{path}", data=json.dumps(caller(payload)).encode(),
        headers={"Content-Type": "application/json"}, method="POST")
    try:
        with urllib.request.urlopen(req, timeout=timeout) as resp:
            return json.loads(resp.read())
    except Exception:
        return {}


# --- service management (platform-specific) -----------------------------------

class LaunchdManager:
    """macOS: per-user LaunchAgents, started at login, kept alive."""

    AGENTS = Path.home() / "Library" / "LaunchAgents"
    SERVICES = {
        "com.silkworm.bot": ["bot.py"],
        "com.silkworm.viz": ["visualizer.py"],
    }

    def _plist(self, label: str, script: str) -> str:
        claude_dir = os.path.dirname(shutil.which("claude") or "/opt/homebrew/bin/claude")
        path_env = ":".join(dict.fromkeys(
            [claude_dir, "/opt/homebrew/bin", "/usr/local/bin", "/usr/bin", "/bin"]))
        return f"""<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key><string>{label}</string>
    <key>ProgramArguments</key>
    <array><string>{VENV_PY}</string><string>{REPO / script}</string></array>
    <key>WorkingDirectory</key><string>{REPO}</string>
    <key>EnvironmentVariables</key>
    <dict><key>PATH</key><string>{path_env}</string></dict>
    <key>RunAtLoad</key><true/>
    <key>KeepAlive</key><true/>
    <key>StandardOutPath</key><string>{LOGS / (label.split('.')[-1] + '.log')}</string>
    <key>StandardErrorPath</key><string>{LOGS / (label.split('.')[-1] + '.err.log')}</string>
</dict>
</plist>
"""

    def _domain(self) -> str:
        return f"gui/{os.getuid()}"

    def _stop(self, label: str) -> None:
        subprocess.run(["launchctl", "bootout", f"{self._domain()}/{label}"],
                       capture_output=True)

    def _start(self, plist: Path) -> None:
        subprocess.run(["launchctl", "bootstrap", self._domain(), str(plist)], check=True)
        # From a non-GUI shell (ssh, scripts) launchd may pend the RunAtLoad
        # spawn — kickstart makes it immediate either way.
        label = plist.stem
        subprocess.run(["launchctl", "kickstart", f"{self._domain()}/{label}"],
                       capture_output=True)

    def _free_ports(self) -> None:
        """Kill whatever holds our ports — a stale ad-hoc bot/visualizer would
        otherwise make the launchd copies crash-loop on bind. Best-effort."""
        lsof = shutil.which("lsof") or "/usr/sbin/lsof"
        if not os.path.exists(lsof):
            return
        for port in (bot_port(), viz_port()):
            try:
                out = subprocess.run([lsof, "-t", f"-iTCP:{port}", "-sTCP:LISTEN"],
                                     capture_output=True, text=True)
            except OSError:
                return
            for pid in out.stdout.split():
                if pid.strip().isdigit() and int(pid) != os.getpid():
                    subprocess.run(["kill", pid.strip()], capture_output=True)

    def install(self) -> bool:
        LOGS.mkdir(exist_ok=True)
        self.AGENTS.mkdir(parents=True, exist_ok=True)
        for label, (script,) in ((k, tuple(v)) for k, v in self.SERVICES.items()):
            plist = self.AGENTS / f"{label}.plist"
            self._stop(label)
            plist.write_text(self._plist(label, script))
        self._free_ports()
        held = self._wait_ports_free()
        for label in self.SERVICES:
            self._start(self.AGENTS / f"{label}.plist")
        if self._held(held):
            return False
        return self._report_up("installed and started")

    def uninstall(self) -> None:
        for label in self.SERVICES:
            self._stop(label)
            (self.AGENTS / f"{label}.plist").unlink(missing_ok=True)
            print(f"  {G}✔{N} {label} removed")

    def restart(self) -> bool:
        for label in self.SERVICES:
            if not (self.AGENTS / f"{label}.plist").exists():
                print(f"  {R}✘{N} {label} not installed — run: silkworm install")
                return False
            self._stop(label)
        self._free_ports()
        held = self._wait_ports_free()
        for label in self.SERVICES:
            self._start(self.AGENTS / f"{label}.plist")
        if self._held(held):
            return False
        return self._report_up("restarted")

    # launchctl returning says launchd accepted the job, not that anything is
    # serving: success used to print from that alone, so a service crash-looping
    # on boot read as restarted, and a `silkworm status` run moments later
    # reported both down while they were still binding. Wait for the ports.
    UP_TIMEOUT = 90.0

    def _probes(self) -> dict:
        return {"com.silkworm.bot": (lambda: bool(bot_call("/status", {}, timeout=2).get("online")),
                                     bot_port()),
                "com.silkworm.viz": (viz_serving, viz_port())}

    def _wait_ports_free(self, timeout: float = 15.0) -> list:
        """Until the old processes let go, a probe would hear them and call
        the new ones up. Returns the ports still held at the deadline: there
        the holder would answer for the new process while it crash-loops on
        bind, so the caller must report failure rather than probe."""
        deadline = time.monotonic() + timeout
        hosts = {viz_port(): viz_hosts()}
        ports = [port for _, port in self._probes().values()]
        while (held := [p for p in ports
                        if any(port_listening(p, h) for h in hosts.get(p, ["127.0.0.1"]))]) \
                and time.monotonic() < deadline:
            time.sleep(0.5)
        return held

    def _held(self, ports: list) -> bool:
        for port in ports:
            print(f"  {R}✘{N} :{port} is still held by another process — "
                  f"lsof -iTCP:{port} -sTCP:LISTEN, stop it, then: silkworm restart")
        return bool(ports)

    def _report_up(self, verb: str) -> bool:
        probes = self._probes()
        pending = dict(probes)
        deadline = time.monotonic() + self.UP_TIMEOUT
        while pending and time.monotonic() < deadline:
            for label in list(pending):
                if pending[label][0]():
                    del pending[label]
            if pending:
                time.sleep(1)
        for label, (_, port) in probes.items():
            if label in pending:
                print(f"  {R}✘{N} {label} {verb} but not answering on :{port} after "
                      f"{int(self.UP_TIMEOUT)}s — see {LOGS / (label.split('.')[-1] + '.err.log')}")
            else:
                print(f"  {G}✔{N} {label} {verb}, answering on :{port}")
        return not pending

    def loaded(self, label: str) -> bool:
        out = subprocess.run(["launchctl", "list"], capture_output=True, text=True)
        return label in out.stdout


def service_manager():
    if sys.platform == "darwin":
        return LaunchdManager()
    sys.exit(f"{WORM} services on {sys.platform} aren't supported yet (macOS only for now)")


# --- checks ---------------------------------------------------------------------

def check(label: str, ok: bool, hint: str = "") -> bool:
    mark = f"{G}✔{N}" if ok else f"{R}✘{N}"
    print(f"  {mark} {label}" + ("" if ok else (f" — {hint}" if hint else "")))
    return ok


def env_tokens_present() -> bool:
    try:
        text = (REPO / ".env").read_text()
    except OSError:
        return False
    return "SLACK_BOT_TOKEN=xoxb-" in text.replace(" ", "") and \
           "SLACK_APP_TOKEN=xapp-" in text.replace(" ", "") and \
           "xoxb-your-token" not in text


def hooks_installed() -> bool:
    try:
        settings = json.loads((Path.home() / ".claude" / "settings.json").read_text())
    except OSError:
        return False
    return "session_hook.py" in json.dumps(settings.get("hooks", {}))


def port_listening(port: str, host: str = "127.0.0.1") -> bool:
    try:
        with socket.create_connection((host, int(port)), timeout=1):
            return True
    except (OSError, ValueError):
        return False


def env_setting(name: str) -> str:
    """A VIZ_* setting from the environment, else .env (where the README says
    to put it). Neither is proof the visualizer saw it: the launchd plist
    passes only PATH and visualizer.py never loads .env -- so callers treat
    it as one more place to look, never the only one."""
    if os.environ.get(name, "").strip():
        return os.environ[name].strip()
    return env_file_value(name) or ""


def viz_hosts() -> list:
    """Where the visualizer may be answering. Loopback first: it is the
    default, and what the installed service binds whatever .env says. Then
    a specific VIZ_BIND address, which refuses 127.0.0.1. A wildcard bind
    answers on loopback, so it adds nothing."""
    hosts = ["127.0.0.1"]
    bind = env_setting("VIZ_BIND")
    if bind not in ("", "0.0.0.0", "::", "localhost", "127.0.0.1"):
        hosts.append(bind)
    return hosts


def viz_host() -> str:
    """The address to show a person: the configured one, if any --
    bracketed if IPv6, since it goes into a URL."""
    host = viz_hosts()[-1]
    return f"[{host}]" if ":" in host else host


def viz_get(path: str, timeout: float = 2) -> bytes:
    """GET from the visualizer, trying each address it may be on. Sends
    VIZ_TOKEN when there is one: off loopback the visualizer demands it on
    every route, the favicon included, and on loopback it is ignored."""
    token = env_setting("VIZ_TOKEN")
    err = None
    for host in viz_hosts():
        netloc = f"[{host}]" if ":" in host else host
        req = urllib.request.Request(f"http://{netloc}:{viz_port()}{path}")
        if token:
            req.add_header("X-Silkworm-Token", token)
        try:
            with urllib.request.urlopen(req, timeout=timeout) as resp:
                return resp.read()
        except Exception as e:
            err = e
    raise err


def viz_serving() -> bool:
    """The visualizer is up -- not that its stats are. /api/stats re-reads
    every transcript and takes over a second on a real install, so as a
    readiness probe it timed out against a healthy server."""
    try:
        viz_get("/favicon.svg")
        return True
    except Exception:
        return False


def do_doctor() -> bool:
    print(f"{WORM} checking prerequisites…")
    ok = True
    ok &= check("claude CLI on PATH", shutil.which("claude") is not None,
                "install Claude Code first: https://claude.com/claude-code")
    ok &= check(f"python {sys.version_info.major}.{sys.version_info.minor} >= 3.10",
                sys.version_info >= (3, 10))
    ok &= check("virtualenv + deps", VENV_PY.exists(), "silkworm setup creates it")
    ok &= check("Slack tokens in .env", env_tokens_present(),
                f"cp .env.example .env and add both tokens (see README), in {REPO}")
    ok &= check("session hooks in ~/.claude/settings.json", hooks_installed(),
                "silkworm setup installs them")
    return ok


def check_daemons(d) -> bool:
    """Report the bot's background threads: all alive, or which have stopped.

    Pulled out of do_status so the wording can be tested without a live bot.
    """
    if not d:
        # An older bot does not report them. Unknown is not all-clear.
        return check("background threads", False,
                     "this bot is too old to report them — run: silkworm restart")
    if not d.get("count"):
        # The local server answers from import time, before __main__ has
        # started a single loop -- so none registered means booting (or stuck
        # before it got that far), not healthy.
        return check("background threads", False,
                     "none started yet — still booting? check again, or see silkworm logs")
    gone = d.get("dead") or []
    names = "; ".join(f"{g.get('name')} ({g.get('reason') or 'stopped'}, "
                      f"noticed {int((g.get('dead_for') or 0) // 60)}m ago)" for g in gone)
    return check(f"background threads alive ({d.get('alive', 0)}/{d.get('count', 0)})",
                 not gone, f"stopped: {names} — see silkworm logs, then: silkworm restart")


def unmerged_row(r: dict) -> str:
    """One branch, for the status listing.

    `commits` is None when git was asked for the count and would not answer,
    and `.get("commits", 0)` printed that as the word None -- while `or 0`
    would have printed it as an empty branch, which is the one thing a branch
    in this list is not. It is shown as "?" instead. A branch with no local
    copy is named with the remote in front of it, since that is the only name
    anything will find it under.
    """
    n = r.get("commits")
    # A row with no `local` field came from an older bot; taken to be local,
    # which is the dashboard's default too, so the two cannot disagree.
    where = f"{r['remote']}/" if r.get("remote") and \
        not r.get("local", True) else ""
    return (f"{where}{r.get('branch', '')} "
            f"({'?' if n is None else n} on {r.get('base', '?')}) "
            f"{(r.get('title') or '')[:52]}")


# --- tailscale serve ------------------------------------------------------------

#: The Mac app ships its CLI inside the bundle; Homebrew's puts it on PATH.
TAILSCALE_APP = Path("/Applications/Tailscale.app/Contents/MacOS/Tailscale")

TAILSCALE_INSTALL = """Tailscale is not installed on this machine. To reach the dashboard from
your phone or laptop over your tailnet:

  1. Install the Tailscale Mac app (https://tailscale.com/download/mac, or the
     Mac App Store) and sign in with the account you will use on your phone.
  2. In the admin console (https://login.tailscale.com/admin/dns) enable
     MagicDNS, then HTTPS Certificates on the same page.
  3. Add your Tailscale login to .env:  VIZ_TAILSCALE_LOGIN=you@example.com
  4. silkworm tailscale on       (tailscale serve --bg {port}; never Funnel)
  5. silkworm tailscale status   should show every check green.
"""


def tailscale_bin() -> str:
    """The tailscale CLI, or "" when Tailscale is not installed."""
    found = shutil.which("tailscale")
    if found:
        return found
    return str(TAILSCALE_APP) if TAILSCALE_APP.exists() else ""


def tailscale_json(ts: str, *args) -> dict:
    """`tailscale <args> --json`, parsed; {} when it fails or says nothing."""
    try:
        out = subprocess.run([ts, *args, "--json"], capture_output=True, text=True,
                             timeout=15)
        return json.loads(out.stdout) if out.returncode == 0 and out.stdout.strip() else {}
    except (OSError, ValueError, subprocess.TimeoutExpired):
        return {}


def serve_entries(cfg: dict) -> tuple:
    """Everything a `tailscale serve status --json` config exposes: web
    proxy targets, and descriptions of anything else (raw TCP forwards, file
    or text handlers), and whether Funnel is on -- including foreground
    sessions and Services, which nest whole configs of their own. A raw TCP
    forward to the dashboard would skip the identity gate: serve adds no
    headers to it."""
    proxies, other, funnel = [], [], any((cfg.get("AllowFunnel") or {}).values())
    for port, tcp in (cfg.get("TCP") or {}).items():
        if (tcp or {}).get("TCPForward"):
            other.append(f"tcp:{port} -> {tcp['TCPForward']}")
    for host, web in (cfg.get("Web") or {}).items():
        for path, h in ((web or {}).get("Handlers") or {}).items():
            if (h or {}).get("Proxy"):
                proxies.append(h["Proxy"])
            else:
                other.append(f"{host}{path} -> {', '.join(sorted(h or {})) or 'handler'}")
    for nested in [*(cfg.get("Foreground") or {}).values(), *(cfg.get("Services") or {}).values()]:
        p, o, f = serve_entries(nested or {})
        proxies += p; other += o; funnel = funnel or f
    return proxies, other, funnel


def tailscale_facts(ts: str) -> dict:
    """What `tailscale status` and `tailscale serve status` say, boiled down."""
    st = tailscale_json(ts, "status")
    me = st.get("Self") or {}
    user = (st.get("User") or {}).get(str(me.get("UserID", "")), {})
    proxies, other, funnel = serve_entries(tailscale_json(ts, "serve", "status"))
    return {"state": st.get("BackendState", ""),
            "login": user.get("LoginName", ""),
            "dns": (me.get("DNSName") or "").rstrip("."),
            "https": bool(st.get("CertDomains")),
            "proxies": proxies, "other": other, "funnel": funnel}


def serves_viz(proxies: list, port: str) -> bool:
    """Serve hands tailnet requests to the dashboard's loopback port."""
    targets = {f"http://127.0.0.1:{port}", f"http://localhost:{port}"}
    return any(p.rstrip("/") in targets for p in proxies)


def tailscale_status(ts: str) -> bool:
    """Every check `silkworm tailscale status` prints; True when all pass."""
    f = tailscale_facts(ts)
    # .env, not the shell: the installed visualizer sees only PATH, so a
    # login exported here but missing from .env would let nobody in.
    port, login = viz_port(), (env_file_value("VIZ_TAILSCALE_LOGIN") or "").strip()
    ok = check(f"tailscale installed ({ts})", True)
    ok &= check("tailscale logged in and running", f["state"] == "Running",
                f"state is {f['state'] or 'unknown'} — open the Tailscale app and sign in")
    ok &= check("HTTPS certificates enabled", f["https"],
                "enable MagicDNS and HTTPS Certificates at "
                "https://login.tailscale.com/admin/dns")
    ok &= check(f"tailscale serve points at the dashboard (:{port})",
                serves_viz(f["proxies"], port),
                f"serving {', '.join(f['proxies']) or 'nothing'} — silkworm tailscale on")
    others = [p for p in f["proxies"] if not serves_viz([p], port)] + f["other"]
    ok &= check("serve exposes nothing else", not others,
                f"also serving {', '.join(others)} — the bot's port trusts every "
                "local caller; tailscale serve reset, then silkworm tailscale on")
    ok &= check("Funnel is off", not f["funnel"],
                "the public internet can reach this — tailscale funnel reset")
    ok &= check("VIZ_TAILSCALE_LOGIN set in .env", bool(login),
                "add VIZ_TAILSCALE_LOGIN=<your Tailscale login> to .env; until then "
                "the dashboard refuses every tailnet request")
    if login:
        ok &= check(f"VIZ_TAILSCALE_LOGIN matches this machine's login "
                    f"({f['login'] or 'unknown'})",
                    login.lower() == f["login"].lower(),
                    f"it is {login}; only that login will be let in")
    if f["dns"] and serves_viz(f["proxies"], port):
        print(f"  dashboard: https://{f['dns']}/")
    return ok


def do_tailscale(argv: list) -> int:
    """silkworm tailscale [status | on | off]. argv excludes the subcommand."""
    sub = argv[0] if argv else "status"
    if sub not in ("status", "on", "off"):
        print("usage: silkworm tailscale [status | on | off]", file=sys.stderr)
        return 2
    ts = tailscale_bin()
    print(f"{WORM} tailscale {sub}")
    if not ts:
        print(TAILSCALE_INSTALL.format(port=viz_port()))
        return 0 if sub == "status" else 1
    if sub == "status":
        return 0 if tailscale_status(ts) else 1
    # Serve only: tailnet devices, over HTTPS. Never `tailscale funnel`.
    cmd = [ts, "serve", "--bg", viz_port()] if sub == "on" else [ts, "serve", "reset"]
    try:
        r = subprocess.run(cmd, capture_output=True, text=True, timeout=60)
    except (OSError, subprocess.TimeoutExpired) as e:
        print(f"  {R}✘{N} {' '.join(cmd)}: {e}")
        return 1
    if r.returncode != 0:
        print(f"  {R}✘{N} {' '.join(cmd)} failed:\n{(r.stderr or r.stdout).strip()}")
        return 1
    print(f"  {G}✔{N} {' '.join(cmd[1:])}")
    if sub == "on" and not (env_file_value("VIZ_TAILSCALE_LOGIN") or "").strip():
        print(f"  {Y}note:{N} VIZ_TAILSCALE_LOGIN is not set, so the dashboard refuses "
              "every tailnet request until you add it to .env")
    return 0 if sub == "off" else (0 if tailscale_status(ts) else 1)


def do_status() -> None:
    mgr = service_manager()
    print(f"{WORM} status")
    for label in mgr.SERVICES:
        check(f"service {label} loaded", mgr.loaded(label), "run: silkworm install")
    bot = bot_call("/status", {}, timeout=2)
    check(f"bot reachable on :{bot_port()}", bool(bot.get("online")),
          "silkworm logs may say why")
    # A reachable bot is not a connected one: the local server answered fine
    # through a seventeen-hour Slack outage.
    link = bot.get("slack") or {}
    if bot.get("online"):
        down = link.get("down_for") or 0
        check("connected to slack", bool(link.get("connected")),
              f"down for {int(down // 60)}m — it should self-restart; silkworm logs")
    # The same cheap probe restart uses: /api/stats takes about two seconds
    # with a real sessions.json, so probing it called a healthy dashboard down.
    check(f"visualizer on http://{viz_host()}:{viz_port()}", viz_serving())
    check("session hooks installed", hooks_installed())
    check_git_guards()
    check_unregistered()

    # A live process is not a working one: each background loop -- sweeper,
    # schedulers, task workers -- ends for good on one escaped exception, and a
    # dead thread logs nothing further. The only symptom was work that quietly
    # stopped happening.
    if bot.get("online"):
        check_daemons(bot.get("daemons"))

    # A wake-up is a promise to check back at a time. Due and unclaimed past a
    # couple of minutes, it is late, and from the thread late looks exactly
    # like a watch that was never scheduled.
    if bot.get("online"):
        if "late_wakeups" not in bot:
            check("scheduled wake-ups on time", False,
                  "this bot predates wake-up lateness — run: silkworm restart")
        else:
            late = bot.get("late_wakeups") or []
            check("scheduled wake-ups on time", not late,
                  f"{len(late)} due and unclaimed — silkworm watching")
            for w in late[:6]:
                print(f"      late {w['late_s'] // 60}m  {w['id']}  {w['goal'][:56]}")

    # A landed fix is not a running fix. Silkworm auto-merges onto its own main
    # and nothing restarts it, so the commit sits in the tree while the live
    # process keeps serving what it booted with -- and until this check existed
    # the only way to tell was to probe for a behaviour difference.
    if bot.get("online"):
        rev = bot.get("revision") or {}
        if not rev:
            # An older bot does not know the field. "Could not ask" is not
            # "up to date", and this check exists precisely for that case.
            check("revision", False,
                  "this bot is too old to report its revision — run: silkworm restart")
        elif rev.get("state") == "unknown":
            check("revision", False, rev.get("message") or "could not resolve it")
        else:
            check(f"revision — {rev.get('message', '')}",
                  rev.get("state") == "current", "run: silkworm restart")

    # A stale credential kills every turn and says nothing until you notice the
    # failures, so it gets checked rather than discovered.
    # What the bot resolved beats what .env currently says: editing .env without
    # restarting leaves the two disagreeing, and that gap is worth surfacing
    # rather than papering over.
    st = bot.get("auth") or creds_state()
    on_disk = creds_state()
    if bot.get("online") and on_disk["mode"] != st["mode"]:
        check("running bot matches .env", False,
              f"bot is using {st['mode']}, .env says {on_disk['mode']} — run: silkworm restart")
    where = ", ".join(st.get("stores") or []) or "nowhere"
    if st["mode"] == "token":
        check("auth: long-lived token (immune to Keychain/file drift)", True)
    elif st["mode"] == "oauth":
        h = st["hours_left"]
        check(f"claude credentials valid ({h/24:.1f}d left, from the {st['source']})",
              h > 24, "run: claude setup-token — see the auth note in the README")
    else:
        check("claude credentials readable", False,
              f"credentials are {st['mode']} (stores: {where})")
    if st["mode"] != "token":
        # Two is the dangerous number, not one. Which single store is in use has
        # already changed under us once, and that is fine; both at once is not.
        check(f"credentials live in exactly one place ({where})",
              len(st.get("stores") or []) == 1,
              "two copies drift, and which one a process uses depends on whether "
              "it can reach the Keychain")
    threads = bot.get("threads", {})
    if threads:
        running = sum(1 for t in threads.values() if t.get("running"))
        out = sum(1 for t in threads.values() if t.get("checked_out"))
        print(f"    {len(threads)} threads · {running} running · {out} checked out to terminal")

    # Finished work whose commits never reached the base. This was invisible:
    # the branch outlives the worktree that made it, and the only record one
    # existed was a line in a Slack reply. Eight tasks completed, the board
    # said `done` eight times, and none of those fixes were in the running bot
    # -- one of them was then implemented a second time from scratch, because
    # the gap was still there for the next night's pass to find.
    if bot.get("online"):
        # Asks git across every project, so it gets longer than a ping.
        unmerged = bot_call("/tasks", {"action": "unmerged"}, timeout=30)
        rows = unmerged.get("unmerged") or []
        if not unmerged.get("ok"):
            # "Could not ask" is not "nothing outstanding". A bot running older
            # code does not know the action, and reporting that as all-clear
            # would be the same silence this check exists to break.
            check("finished work is all merged", False,
                  f"could not ask: {unmerged.get('error') or 'no answer'}")
        else:
            check("finished work is all merged", not rows,
                  f"{unmerged.get('summary') or 'some is not'} — land or drop them")
        for r in rows[:12]:
            print(f"      {unmerged_row(r)}")
        if len(rows) > 12:
            print(f"      …and {len(rows) - 12} more")

    # Work that never even reached a commit. A checkout holding uncommitted
    # changes is never swept and never deleted -- correctly -- and until now
    # the only trace of one was a log line at INFO, repeated every half hour to
    # nobody. A branch at least survives a disk tidy; an untracked file in a
    # directory outside any repository does not.
    if bot.get("online"):
        held = bot_call("/tasks", {"action": "holding"}, timeout=30)
        hrows = held.get("holding") or []
        if not held.get("ok"):
            # Same rule as above: "could not ask" is not "nothing held".
            check("no checkout is holding uncommitted work", False,
                  f"could not ask: {held.get('error') or 'no answer'}")
        else:
            check("no checkout is holding uncommitted work", not hrows,
                  f"{held.get('summary') or 'some is'} — commit it or clear it "
                  f"yourself; nothing here will")
        for r in hrows[:12]:
            who = r.get("title") or ("no task on the board owns this"
                                     if not r.get("known") else r.get("id", ""))
            print(f"      {r.get('path', '')}")
            print(f"        {r.get('changes', 0)} uncommitted "
                  f"({', '.join(r.get('files') or [])[:64]}) · "
                  f"{r.get('state') or 'unknown'} · {who[:52]}")
        if len(hrows) > 12:
            print(f"      …and {len(hrows) - 12} more")


sys.path.insert(0, str(REPO))
import credentials                                   # noqa: E402
import envfile                                       # noqa: E402
import git_guard                                     # noqa: E402
import jsonstore                                     # noqa: E402
import workspaces                                    # noqa: E402
import operator_role                                 # noqa: E402


def check_unregistered(path: Path | None = None, roots=None) -> list[str]:
    """Git repositories in the workspace that no project covers.

    Read from projects.json and the disk rather than asked of the bot, like
    the git guard: whether a repository is registered does not depend on the
    bot being up. Roots are ~/workspace and Silkworm's scratch folder.
    """
    try:
        recs = jsonstore.load(path or REPO / "projects.json", default={}, repair=False) or {}
    except Exception as e:
        check("every repo in the workspace is a project", False,
              f"could not read projects.json: {e}")
        return []
    if roots is None:
        scratch = env_file_value("CLAUDE_CWD") or str(REPO / "workspace")
        roots = [workspaces.ROOT, Path(scratch).expanduser()]
    found = workspaces.unregistered(roots, [{**r, "slug": r.get("slug") or s}
                                            for s, r in recs.items()])
    check("every repo in the workspace is a project", not found,
          f"unregistered repos: {len(found)} — `!project new <Name> <path>` registers one")
    for r in found[:12]:
        print(f"      {r}")
    if len(found) > 12:
        print(f"      …and {len(found) - 12} more")
    return found


def check_git_guards(path: Path | None = None) -> list[tuple[str, bool, str]]:
    """Whether each ready project's repo refuses an implementor's push/base move.

    Read from the repositories themselves rather than asked of the bot: the
    hooks are what is in force, whatever the bot believes it installed, and
    they are in force (or not) whether or not the bot is up.
    """
    try:
        recs = jsonstore.load(path or REPO / "projects.json", default={}, repair=False) or {}
    except Exception as e:
        check("implementor git guard", False, f"could not read projects.json: {e}")
        return []
    rows = git_guard.ready_repos([{**r, "slug": r.get("slug") or s}
                                  for s, r in recs.items()])
    if not rows:
        print("    no ready project to guard")
    out = []
    for slug, cwd in rows:
        ok, why = git_guard.state(cwd)
        check(f"implementor git guard on {slug}", ok,
              f"{why} — the bot installs it at startup: run silkworm restart")
        out.append((slug, ok, why))
    return out


def env_has(name: str) -> bool:
    """Whether .env sets a variable, without reading its value."""
    return env_file_value(name) is not None or bool(os.environ.get(name))


def creds_state() -> dict:
    return credentials.state(has_token=env_has("CLAUDE_CODE_OAUTH_TOKEN"))


def keychain_item_present() -> bool:
    return credentials.keychain_item_present()


def do_file_task(argv) -> None:
    """File a task from inside a turn, for work just scoped with the user."""
    key = os.environ.get("SILKWORM_THREAD", "")
    if not key:
        print("no thread — `task` only works from inside a Silkworm turn")
        raise SystemExit(1)
    project, role, goal, propose = "", "", [], False
    i = 0
    while i < len(argv):
        if argv[i] == "--propose":
            propose = True; i += 1
        elif argv[i] == "--project" and i + 1 < len(argv):
            project = argv[i + 1]; i += 2
        elif argv[i] == "--role" and i + 1 < len(argv):
            role = argv[i + 1]; i += 2
        else:
            goal.append(argv[i]); i += 1
    goal = " ".join(goal).strip()
    if not goal:
        print('usage: silkworm task [--propose] [--project <slug>] '
              '[--role implementor|assistant|researcher] "<goal>"')
        raise SystemExit(2)
    r = bot_call("/file-task", {"key": key, "goal": goal, "propose": propose,
                                "project": project, "role": role or "implementor",
                                # What this run *is*, from the environment the
                                # bot set up for it, not from anything the turn
                                # chose. A read-only role's work waits for a
                                # person whether or not it asked --propose.
                                "caller_role": os.environ.get("SILKWORM_ROLE", ""),
                                # Which task this run is, so a research run's
                                # next steps are filed under it. Only picks
                                # between tasks the bot already sees running on
                                # this thread; see bot.research_parent.
                                "caller_task": os.environ.get("SILKWORM_TASK_ID", "")})
    if not r.get("ok"):
        print(f"not filed: {r.get('error') or 'the bot did not answer'}")
        raise SystemExit(1)
    print(f"filed {r['id']} ({r.get('state', 'queued')}) as {r['role']}"
          + (f" under {r['project']}" if r.get("project") else "")
          + f" in {r.get('cwd') or '?'} ({r['remaining']} more allowed this turn)")


def do_defer(argv) -> None:
    """Schedule a later turn on the thread this run belongs to.

    Meant to be called by Claude from inside a turn, not typed by hand: the
    thread comes from the environment the bot set up for that run.
    """
    import os
    key = os.environ.get("SILKWORM_THREAD", "")
    depth = os.environ.get("SILKWORM_DEFERS", "0")
    if not key:
        print("no thread — `defer` only works from inside a Silkworm turn")
        raise SystemExit(1)
    if len(argv) < 2:
        print('usage: silkworm defer <delay> "<what to check when you wake>"')
        raise SystemExit(2)
    delay, goal = argv[0], " ".join(argv[1:])
    r = bot_call("/defer", {"key": key, "delay": delay, "goal": goal, "depth": depth})
    if not r.get("ok"):
        print(f"could not schedule: {r.get('error') or 'the bot did not answer'}")
        raise SystemExit(1)
    print(f"scheduled: waking in {r['in_s']}s to \"{goal[:60]}\" "
          f"({r['remaining']} wake-ups left in this chain)")


# --- action commands: the dashboard's buttons, for scripts and agents ----------
#
# Each is one POST to the bot's /tasks route with the action the dashboard's
# button sends, so it runs the same handler and the same transition(), and a
# refusal is the bot's own words. Nothing here decides whether an action is
# allowed: a check in the CLI would be a second rule that could drift from the
# first, and the operator role is meant to see exactly what a click would.

#: Exit codes. Stable: the operator role and any script branch on them.
EXIT_OK, EXIT_REFUSED, EXIT_USAGE, EXIT_UNREACHABLE = 0, 1, 2, 3


class BotUnreachable(Exception):
    """The bot could not be asked at all -- not the same as it saying no."""


def caller(payload: dict) -> dict:
    """`payload` stamped with who is asking, from the environment the bot set.

    The bot holds an operator turn to its policy by these (operator_role
    caller_is_operator): the role, and the thread as a second signal. The
    operator's allowlist is prefix-matched against the command as typed, so
    it has no way to run this with either changed. Nothing is added outside
    a turn -- your own CLI and the dashboard are never asked about.
    """
    out = dict(payload)
    role, thread = os.environ.get("SILKWORM_ROLE", ""), os.environ.get("SILKWORM_THREAD", "")
    if role:
        out["caller_role"] = role
    if thread:
        out["caller_thread"] = thread
    return out


def bot_ask(path: str, payload: dict, timeout: float = 30) -> dict:
    """bot_call for commands that must tell "no answer" from "refused".

    bot_call turns every failure into {}, which suits a health check that
    reads `.get("ok")`, but here an unreachable bot and a refusal need
    different exit codes. Raises BotUnreachable; returns whatever the bot
    said, {} included -- the server answers {} when a handler raised.
    """
    req = urllib.request.Request(
        f"http://127.0.0.1:{bot_port()}{path}", data=json.dumps(caller(payload)).encode(),
        headers={"Content-Type": "application/json"}, method="POST")
    try:
        with urllib.request.urlopen(req, timeout=timeout) as resp:
            body = resp.read()
    except Exception as e:
        raise BotUnreachable(f"the bot did not answer on :{bot_port()} ({e})") from e
    try:
        answer = json.loads(body) if body else {}
    except ValueError as e:
        raise BotUnreachable(f"the bot's answer on :{bot_port()} was not JSON") from e
    return answer if isinstance(answer, dict) else {}


#: command -> (the /tasks action, {flag: payload key}, flags it must have).
#: The action names are the dashboard's (visualizer taskAction / handle_tasks).
TASK_ACTIONS = {
    "accept":  ("accept",  {}, ()),
    "dismiss": ("dismiss", {"--round": "round"}, ()),
    "land":    ("land",    {}, ()),
    "drop":    ("drop",    {}, ()),
    "edit":    ("edit",    {"--goal": "goal", "--title": "title"}, ()),
    # The send-back with notes. The route would take none, and send the work
    # back with only "another pass" -- a rerun of the same goal, which is
    # never what a command typed on purpose means. So the CLI asks for them.
    "rework":  ("rework",  {"--notes": "notes"}, ("--notes",)),
    "close":   ("close",   {"--round": "round"}, ()),
    # A blank question is the bot's to refuse, and it does.
    "dig":     ("dig",     {"--notes": "notes", "--round": "round"}, ()),
    # The dashboard's Retry and Run next. Tidy takes a checkout's path, not a
    # task id: it removes a finished task's checkout holding only generated
    # files, and refuses one holding anything else.
    "retry":    ("retry",    {}, ()),
    "run-next": ("run-next", {}, ()),
    "tidy":     ("tidy",     {}, ()),
}


def action_usage(cmd: str) -> str:
    _, flags, required = TASK_ACTIONS[cmd]
    opts = " ".join(f"{f} <{f[2:]}>" if f in required else f"[{f} <{f[2:]}>]"
                    for f in flags)
    return f"usage: silkworm {cmd} <task id> {opts} [--by <name>]".replace("  ", " ")


def parse_action(cmd: str, argv: list) -> dict:
    """The payload for `cmd`, from the arguments after the subcommand.

    Raises ValueError with the usage line. argv excludes the subcommand
    itself: `silkworm accept tsk_1` reads tsk_1 as the id, not "accept".
    """
    action, flags, required = TASK_ACTIONS[cmd]
    payload, ids, given = {"action": action, "by": default_by()}, [], set()
    i = 0
    while i < len(argv):
        a = argv[i]
        if a in flags or a == "--by":
            if i + 1 >= len(argv):
                raise ValueError(f"{a} needs a value\n{action_usage(cmd)}")
            if not argv[i + 1].strip():
                # A blank --notes would send work back with nothing new to go
                # on, and a blank --by leaves "via " in the event log.
                raise ValueError(f"{a} needs a value\n{action_usage(cmd)}")
            payload["by" if a == "--by" else flags[a]] = argv[i + 1]
            given.add(a)
            i += 2
        elif a.startswith("-"):
            raise ValueError(f"unknown option {a}\n{action_usage(cmd)}")
        else:
            ids.append(a)
            i += 1
    if len(ids) != 1:
        raise ValueError(action_usage(cmd))
    missing = [f for f in required if f not in given]
    if missing:
        raise ValueError(f"{', '.join(missing)} is required\n{action_usage(cmd)}")
    if cmd == "edit" and not given & {"--goal", "--title"}:
        raise ValueError(f"say what to change\n{action_usage(cmd)}")
    payload["id"] = ids[0]
    if cmd == "tidy":
        payload["path"] = ids[0]
    return payload


def operator_state_path() -> Path:
    # SILKWORM_OPERATOR_STATE for the tests, as SILKWORM_BOT_PORT is.
    return Path(os.environ.get("SILKWORM_OPERATOR_STATE") or REPO / "operator.json")


def default_by() -> str:
    return "operator" if os.environ.get("SILKWORM_ROLE") == operator_role.ROLE else "cli"


def operator_refusal(action: str, payload: dict, state=None) -> str:
    """The CLI's half of the operator's policy: what it refuses before asking.

    Only what needs no git and no store to decide -- accepting, approving,
    releasing -- checked against your approvals read-only (the bot uses them
    up). The rest (a drop, trader's landings) needs the task's branch, and the
    bot decides it; it refuses the same verbs again either way.
    """
    if os.environ.get("SILKWORM_ROLE") != operator_role.ROLE:
        return ""
    state = state or operator_role.State(operator_state_path(), readonly=True)
    return operator_role.check(state, operator_role.tasks_guard(action, payload, None))


def do_task_action(cmd: str, argv: list, ask=None) -> int:
    """Run one action command; print one line; return the exit code."""
    ask = ask or bot_ask
    try:
        payload = parse_action(cmd, argv)
    except ValueError as e:
        print(str(e), file=sys.stderr)
        return EXIT_USAGE
    why = operator_refusal(payload["action"], payload)
    if why:
        print(f"refused: {cmd} {payload['id']}: {why}", file=sys.stderr)
        return EXIT_REFUSED
    try:
        r = ask("/tasks", payload, timeout=60)
    except BotUnreachable as e:
        print(f"not done: {e}", file=sys.stderr)
        return EXIT_UNREACHABLE
    if not r.get("ok"):
        why = r.get("error") or ("the bot gave no reason (its handler may have "
                                 "failed; see silkworm logs)")
        print(f"refused: {cmd} {payload['id']}: {why}", file=sys.stderr)
        return EXIT_REFUSED
    task = r.get("task") or {}
    line = f"ok: {cmd} {payload['id']}"
    if task.get("state"):
        line += f" -> {task['state']}"
    extra = "; ".join(x for x in (r.get("note"), r.get("held")) if x)
    print(line + (f" ({extra})" if extra else ""))
    return EXIT_OK


OPERATOR_USAGE = ("usage: silkworm operator notes [--set TEXT] | "
                  "contained <task id> | approvals | git [--in PATH] <read-only git command>")


def do_operator(argv, ask=None, notes_path=None, state=None) -> int:
    """`silkworm operator ...`: the operator's own bookkeeping.

    notes            print its notes file
    notes --set T    replace it (at most 4KB; refused, not cut, if longer)
    contained <id>   whether a task's branch is already on its base, by
                     content -- exit 0 contained, 1 not (or refused), 3 bot down
    approvals        what you have approved for it, unused
    git [--in P] …   a read-only git command (operator_role.GIT_READS), vetted
                     for options that write a file or run a program
    """
    ask = ask or bot_ask
    notes_path = notes_path or (REPO / "operator_notes.md")
    sub = argv[0] if argv else ""
    if sub == "notes" and len(argv) == 1:
        print(operator_role.read_notes(notes_path) or "(no notes yet)")
        return EXIT_OK
    if sub == "notes" and len(argv) == 3 and argv[1] == "--set":
        why = operator_role.write_notes(notes_path, argv[2])
        if why:
            print(f"refused: {why}", file=sys.stderr)
            return EXIT_REFUSED
        print(f"ok: notes saved ({len(argv[2].strip().encode())} bytes)")
        return EXIT_OK
    if sub == "contained" and len(argv) == 2:
        try:
            r = ask("/tasks", {"action": "contained", "id": argv[1]})
        except BotUnreachable as e:
            print(f"not done: {e}", file=sys.stderr)
            return EXIT_UNREACHABLE
        if not r.get("ok"):
            print(f"refused: {r.get('error') or 'no answer'}", file=sys.stderr)
            return EXIT_REFUSED
        print(f"{'contained' if r.get('contained') else 'not contained'}: "
              f"{r.get('branch')}: {r.get('why')}")
        return EXIT_OK if r.get("contained") else EXIT_REFUSED
    if sub == "git":
        # Read-only git, vetted: raw git is not on the operator's allowlist
        # because `git log --output=<file>` writes anywhere (operator_role).
        rest, where = list(argv[1:]), Path.cwd()
        if rest[:1] == ["--in"] and len(rest) >= 2:
            where, rest = Path(rest[1]).expanduser(), rest[2:]
        why = operator_role.git_refusal(rest)
        if why:
            print(f"refused: {why}", file=sys.stderr)
            return EXIT_REFUSED if rest else EXIT_USAGE
        try:
            return subprocess.run(operator_role.git_command(rest), cwd=str(where),
                                  timeout=120).returncode
        except (OSError, subprocess.SubprocessError) as e:
            print(f"refused: {e}", file=sys.stderr)
            return EXIT_REFUSED
    if sub == "approvals" and len(argv) == 1:
        state = state or operator_role.State(operator_state_path(), readonly=True)
        live = state.approvals()
        print("\n".join(f"{a['guard']} {a['item']}" for a in live) or "(none)")
        return EXIT_OK
    print(OPERATOR_USAGE, file=sys.stderr)
    return EXIT_USAGE


def _row(t: dict, *keys) -> dict:
    return {k: t.get(k) for k in ("id", "title", "state") + keys}


def status_summary(ask) -> dict:
    """What `status --json` prints: the board as the operator needs to see it.

    Each part is its own read-only question to the bot, as the dashboard asks
    it. One that cannot be answered goes in `errors` and turns `ok` false:
    "could not ask" must never read as "nothing there".
    """
    out = {"ok": True, "errors": [], "bot": {"online": False}, "needs_you": {},
           "tasks": {}, "unlanded": {}, "watching": []}

    def asked(what, payload, timeout=30):
        # A part that times out after /status answered is that part unasked,
        # not the bot offline: the branch survey asks git and can be slow.
        try:
            r = ask("/tasks", payload, timeout=timeout)
        except BotUnreachable as e:
            out["errors"].append(f"{what}: {e}")
            return None
        if not r.get("ok"):
            out["errors"].append(f"{what}: {r.get('error') or 'no answer'}")
            return None
        return r

    st = ask("/status", {}, timeout=10)      # BotUnreachable propagates
    rev = st.get("revision") or {}
    out["bot"] = {
        "online": bool(st.get("online")),
        # What the process booted from against what the checkout is at now.
        "revision": {"state": rev.get("state") or "unknown",
                     "running": rev.get("started") or "",
                     "head": rev.get("head") or "",
                     "behind": rev.get("behind") or 0,
                     "message": rev.get("message") or ""},
        "drain": {"draining": bool((st.get("drain") or {}).get("seconds")),
                  **(st.get("drain") or {})},
        "runner_hold": st.get("runner_hold") or {},
    }
    if not rev:
        out["errors"].append("revision: this bot does not report one")

    r = asked("needs you", {"action": "attention", "slim": True})
    for t in (r or {}).get("tasks") or []:
        row = _row(t, "role")
        if t.get("round"):
            row["round"] = t["round"]          # for close/dig/dismiss --round
        step = (t.get("needs_user") or {}).get("action")
        if step:
            row["step"] = step
        out["needs_you"].setdefault(t.get("project") or "", {}) \
            .setdefault(t.get("state") or "", []).append(row)

    for state in ("queued", "running", "blocked"):
        r = asked(state, {"action": "list", "state": state, "slim": True})
        out["tasks"][state] = [_row(t, "project", "role")
                               for t in (r or {}).get("tasks") or []]

    r = asked("unlanded", {"action": "unmerged"}, timeout=60)
    for b in (r or {}).get("unmerged") or []:
        landing = b.get("landing") or {}
        out["unlanded"].setdefault(b.get("project") or "", []).append({
            "id": b.get("id"), "title": b.get("title"), "branch": b.get("branch"),
            "base": b.get("base"), "commits": b.get("commits"),
            # The last landing's outcome, "" when none was ever tried.
            "stage": landing.get("stage") or "", "detail": landing.get("detail") or ""})

    r = asked("watching", {"action": "watching"})
    out["watching"] = [{k: w.get(k) for k in ("id", "in_s", "goal", "thread")}
                       for w in (r or {}).get("watching") or []]
    out["ok"] = not out["errors"]
    return out


def do_status_json(ask=None) -> int:
    ask = ask or bot_ask
    try:
        out = status_summary(ask)
    except BotUnreachable as e:
        print(json.dumps({"ok": False, "errors": [str(e)], "bot": {"online": False}}))
        return EXIT_UNREACHABLE
    print(json.dumps(out))
    return EXIT_OK if out["ok"] else EXIT_REFUSED


def do_setup() -> None:
    print(f"{WORM} setting up in {REPO}")
    if not check("claude CLI on PATH", shutil.which("claude") is not None,
                 "install Claude Code first, then re-run"):
        sys.exit(1)

    if not VENV_PY.exists():
        print("  creating virtualenv + installing deps…")
        subprocess.run([sys.executable, "-m", "venv", str(REPO / ".venv")], check=True)
        subprocess.run([str(REPO / ".venv" / "bin" / "pip"), "install", "-q",
                        "-r", str(REPO / "requirements.txt")], check=True)
    check("virtualenv + deps", True)

    env = REPO / ".env"
    if not env.exists():
        shutil.copy(REPO / ".env.example", env)
        print(f"  created {env}")
    if not env_tokens_present():
        print(f"\n{WORM} add your Slack tokens to {env} first:")
        print("  1. https://api.slack.com/apps → Create New App → From a manifest → paste manifest.json")
        print("  2. Basic Information → App-Level Tokens → generate with connections:write → SLACK_APP_TOKEN")
        print("  3. Install App → Bot User OAuth Token → SLACK_BOT_TOKEN")
        print(f"  then re-run: silkworm setup")
        sys.exit(1)
    check("Slack tokens in .env", True)

    subprocess.run([sys.executable, str(REPO / "install_hooks.py")], check=True)
    print(f"{WORM} installing login services…")
    up = service_manager().install()
    print()
    do_status()
    if not up:
        sys.exit(f"\n{WORM} services did not come up — see silkworm logs, then: silkworm restart")
    print(f"\n{WORM} done — DM your bot in Slack, and open http://127.0.0.1:{viz_port()}")


# --- session launch / import ------------------------------------------------------

def find_transcript_sid(cwd: str) -> str | None:
    """Most recently written session in cwd's Claude project dir."""
    proj = Path.home() / ".claude" / "projects" / cwd.replace("/", "-")
    files = sorted(proj.glob("*.jsonl"), key=lambda p: p.stat().st_mtime, reverse=True)
    return files[0].stem if files else None


def latest_summary(session_id: str, cwd: str) -> str | None:
    path = Path.home() / ".claude" / "projects" / cwd.replace("/", "-") / f"{session_id}.jsonl"
    summary = None
    try:
        for line in path.read_text().splitlines():
            try:
                d = json.loads(line)
            except json.JSONDecodeError:
                continue
            if d.get("type") == "summary" and d.get("summary"):
                summary = d["summary"]
    except OSError:
        pass
    return summary


def do_import() -> None:
    """Register every running interactive claude session with Silkworm."""
    # Read it the way the store does. The bot rewrites this file underneath us,
    # and catching only OSError left a half-written one crashing the CLI on the
    # JSONDecodeError. repair=False: the bot owns the file, we are looking at it.
    try:
        sessions = jsonstore.load(REPO / "sessions.json", default={}, repair=False)
    except jsonstore.CorruptStore as exc:
        # Carrying on with an empty set would re-register sessions Silkworm
        # already tracks, which is worse than not importing this once.
        print(f"{WORM} cannot read sessions.json — {exc}")
        return
    known = {(v.get("session_id") if isinstance(v, dict) else v) for v in sessions.values()}

    out = subprocess.run(["ps", "-axo", "pid=,command="], capture_output=True, text=True)
    pids = []
    for line in out.stdout.splitlines():
        pid, _, cmd = line.strip().partition(" ")
        if cmd.strip().startswith("claude") and "--session-id" not in cmd and " -p" not in cmd:
            pids.append(int(pid))

    if not pids:
        print(f"{WORM} no running claude sessions found")
        return
    for pid in pids:
        lsof = subprocess.run(["lsof", "-a", "-p", str(pid), "-d", "cwd", "-Fn"],
                              capture_output=True, text=True)
        cwd = next((l[1:] for l in lsof.stdout.splitlines() if l.startswith("n")), None)
        if not cwd:
            print(f"  pid {pid}: could not determine cwd — skipped")
            continue
        sid = find_transcript_sid(cwd)
        if not sid:
            print(f"  pid {pid} ({cwd}): no session transcript found — skipped")
            continue
        if sid in known:
            print(f"  pid {pid} ({cwd}): session {sid[:8]}… already tracked — skipped")
            continue
        title = latest_summary(sid, cwd) or Path(cwd).name or "home"
        answer = bot_call("/register-terminal",
                          {"session_id": sid, "cwd": cwd, "title": title[:80], "live": True},
                          timeout=5)
        if answer.get("ok"):
            known.add(sid)
            print(f"  {G}✔{N} pid {pid} ({Path(cwd).name or 'home'}) {sid[:8]}… → {answer['link']}")
        elif answer:
            print(f"  {R}✘{N} pid {pid} ({cwd}): {answer.get('error')}")
        else:
            print(f"  {R}✘{N} bot unreachable — is it running? (silkworm status)")
            return


# --- deploy: a restart that does not kill work -----------------------------------
#
# Thirteen restarts in ten days to load new code killed every turn that was
# running at the time -- nine runs ended exit 143 -- and an interrupted task
# started over from scratch. `restart` is still there for when that is what you
# want; this is the one to load code with.

#: Nothing running for this long before restarting: one turn ending is often
#: followed straight away by the next (a review after its implementor, a reply
#: to a reply), and restarting in that gap would kill the second.
DEPLOY_QUIET_S = 30
DEPLOY_MAX_WAIT_S = 2 * 3600
#: How often the wait says what it is still waiting on.
DEPLOY_PROGRESS_S = 60
#: Asked of the bot on top of the wait, so the drain outlasts it -- but not by
#: much: a deploy killed part-way leaves a drain that lapses on its own.
DEPLOY_DRAIN_MARGIN_S = 600
#: How long the restarted bot gets to reconnect to Slack and report itself.
DEPLOY_CONFIRM_S = 90


def parse_duration(text: str) -> int:
    """`90`, `90s`, `15m`, `2h` -> seconds. Raises ValueError otherwise."""
    text = (text or "").strip().lower()
    mult = {"s": 1, "m": 60, "h": 3600}.get(text[-1:], 0)
    n = float(text[:-1] if mult else text)
    if n < 0:
        raise ValueError(text)
    return int(n * (mult or 1))


def git_out(repo: Path, *args: str) -> tuple[int, str]:
    try:
        r = subprocess.run(["git", "-C", str(repo), *args],
                           capture_output=True, text=True, timeout=30)
    except (OSError, subprocess.TimeoutExpired) as e:
        return 1, str(e)
    return r.returncode, r.stdout.strip()


def base_branch(repo: Path, git=git_out) -> str:
    """The branch deploys come from: origin's default, else `main`.

    Resolved through symbolic-ref rather than by splitting a string -- the
    split once answered "HEAD" -- and stripped of exactly the remote prefix.
    """
    code, ref = git(repo, "symbolic-ref", "--quiet", "--short", "refs/remotes/origin/HEAD")
    if code == 0 and ref.startswith("origin/") and len(ref) > len("origin/"):
        return ref[len("origin/"):]
    return "main"


def run_suite() -> int:
    py = str(VENV_PY) if VENV_PY.exists() else sys.executable
    # As the bot's own verification runs it: outside any turn. Run from inside
    # one (deploy --after-turn), the turn's variables would make the suite's
    # own CLI runs behave as that turn -- an operator's, refused.
    env = git_guard.strip(dict(os.environ))
    for k in ("SILKWORM_ROLE", "SILKWORM_THREAD", "SILKWORM_DEFERS", "SILKWORM_BOT"):
        env.pop(k, None)
    return subprocess.run([py, str(REPO / "tests" / "test_invariants.py")],
                          capture_output=True, text=True, env=env).returncode


def busy_line(row: dict) -> str:
    kind = (row["kind"] if row.get("kind") in ("landing", "release")
            else (row.get("driver") or "task"))
    orphan = "" if row.get("live", True) else " — no live process holds it"
    return f"{row.get('id', '?')} ({kind}) {row.get('title', '')[:56]}{orphan}"


def deploy_preflight(repo: Path, skip_tests: bool, *, git=git_out, suite=run_suite) -> list:
    """Reasons not to deploy this checkout. Empty means go.

    The running bot is about to become whatever this tree is, so the tree must
    be a commit on the base branch (the revision check afterwards compares
    against HEAD, and a dirty tree is no commit) and must pass its own tests.
    """
    problems = []
    code, branch = git(repo, "rev-parse", "--abbrev-ref", "HEAD")
    base = base_branch(repo, git)
    if code != 0 or not branch:
        problems.append("could not tell which branch this checkout is on")
    elif branch != base:
        problems.append(f"checkout is on {branch}, not {base} — deploy from {base}")
    code, dirty = git(repo, "status", "--porcelain", "--untracked-files=no")
    if code != 0:
        problems.append("could not read git status")
    elif dirty:
        n = len(dirty.splitlines())
        problems.append(f"{n} uncommitted change(s) to tracked files — commit or stash them")
    if problems or skip_tests:
        return problems           # no point spending the suite on a refusal
    print(f"  {Y}·{N} running the test suite…")
    if suite() != 0:
        problems.append("the test suite fails — run: silkworm test")
    return problems


def wait_for_quiet(call, *, max_wait: float, quiet_s: float = DEPLOY_QUIET_S,
                   progress_s: float = DEPLOY_PROGRESS_S, drain_s: float = 0,
                   clock=time.monotonic, sleep=time.sleep, poll_s: float = 5,
                   ignore=()) -> tuple[bool, list]:
    """Wait until nothing has been running for `quiet_s`. (ok, still running).

    "Nothing" is judged by the bot, and an unanswered question is never
    quiet: a bot that stops answering mid-wait is not evidence it is idle.
    If the drain is found lifted -- the bot restarted under us, or someone
    undrained it -- it is put back, or new work would start mid-wait.
    A task in `ignore` does not count once no live process holds it.
    """
    start = clock()
    quiet_since = None
    last_said = None
    rows: list = []
    while True:
        now = clock()
        r = call("/drain", {"action": "status"})
        if r.get("ok"):
            rows = [row for row in (r.get("running") or [])
                    if not (row.get("id") in ignore and not row.get("live", True))]
            if not r.get("draining") and drain_s:
                call("/drain", {"action": "start", "why": "deploy",
                                "seconds": max(60, drain_s - (now - start))})
        if r.get("ok") and not rows:
            quiet_since = now if quiet_since is None else quiet_since
            if now - quiet_since >= quiet_s:
                return True, []
        else:
            quiet_since = None
        if now - start >= max_wait:
            return False, rows if r.get("ok") else [{"id": "?", "title": "the bot stopped answering",
                                                      "kind": "task", "live": True}]
        if last_said is None or now - last_said >= progress_s:
            waited = int(now - start)
            if not r.get("ok"):
                print(f"  {Y}·{N} {waited}s: the bot is not answering — waiting")
            elif rows:
                print(f"  {Y}·{N} {waited}s: waiting on {len(rows)} running:")
                for row in rows[:8]:
                    print(f"      {busy_line(row)}")
            else:
                print(f"  {Y}·{N} {waited}s: nothing running — "
                      f"restarting after {int(quiet_s)}s of quiet")
            last_said = now
        sleep(poll_s)


DEPLOY_USAGE = ("usage: silkworm deploy [--now] [--skip-tests] [--max-wait 2h]\n"
                "       silkworm deploy --after-turn [--skip-tests] [--max-wait 2h]")


def do_deploy(argv, *, repo: Path = REPO, call=None, manager=None, git=git_out,
              suite=run_suite, clock=time.monotonic, sleep=time.sleep,
              confirm_s: float = DEPLOY_CONFIRM_S, handoff=None, lock_path=None,
              log_path=None, alive=None) -> int:
    """Restart the bot onto this checkout without killing work. Exit status."""
    call = call or (lambda path, payload: bot_call(path, payload, timeout=10))
    now, skip_tests, after_turn, max_wait = False, False, False, DEPLOY_MAX_WAIT_S
    i = 0
    while i < len(argv):
        a = argv[i]
        if a == "--now":
            now = True
        elif a == "--skip-tests":
            skip_tests = True
        elif a == "--after-turn":
            after_turn = True
        elif a == "--max-wait" and i + 1 < len(argv):
            try:
                max_wait = parse_duration(argv[i + 1])
            except ValueError:
                print(f"{WORM} --max-wait takes a duration like 90m or 2h, not {argv[i + 1]!r}")
                return 2
            i += 1
        else:
            print(DEPLOY_USAGE)
            return 2
        i += 1
    if now and after_turn:
        # --now interrupts whatever runs; after a turn, the point is not to.
        print(f"{WORM} --now and --after-turn do not go together\n{DEPLOY_USAGE}")
        return 2

    if os.environ.get("SILKWORM_ROLE") == operator_role.ROLE:
        why = operator_deploy_refusal(call, after_turn, skip_tests)
        if why:
            print(f"{WORM} refused for the operator: {why}")
            return 1
    print(f"{WORM} deploy {repo}" + (" (after this turn)" if after_turn else ""))
    if after_turn:
        return deploy_after_turn(repo, skip_tests=skip_tests, max_wait=max_wait,
                                 git=git, suite=suite, handoff=handoff or detach,
                                 lock_path=lock_path or AFTER_TURN_LOCK,
                                 log_path=log_path or AFTER_TURN_LOG,
                                 alive=alive or deploy_pid_alive)
    # From inside a turn this would wait on its own turn for two hours, and
    # then restart the process it is a child of.
    if os.environ.get("SILKWORM_THREAD"):
        print(f"  {R}✘{N} not from inside a Silkworm turn: it would wait on itself, "
              f"and the restart kills the turn running it — use "
              f"`silkworm deploy --after-turn`, which deploys once this turn has ended")
        return 1

    problems = deploy_preflight(repo, skip_tests, git=git, suite=suite)
    for p in problems:
        print(f"  {R}✘{N} {p}")
    if problems:
        return 1
    print(f"  {G}✔{N} checkout is clean on its base branch"
          + (" (tests skipped)" if skip_tests else ", tests pass"))
    code, head = git(repo, "rev-parse", "HEAD")
    if code != 0 or not head:
        print(f"  {R}✘{N} could not resolve HEAD")
        return 1
    # One deploy at a time, whichever way it was started: a terminal deploy
    # under a pending --after-turn would restart the bot twice, and the second
    # would report the first's revision as a failure.
    lock_path = lock_path or AFTER_TURN_LOCK
    me = os.getpid()
    held = take_deploy_lock(lock_path, {"pid": me, "stage": "deploying from a terminal",
                                        "head": head, "log": "", "started": time.time()},
                            alive=alive or deploy_pid_alive)
    if held is not None:
        report_pending(held, head, log_path or AFTER_TURN_LOG)
        return 1
    try:
        code, _why = deploy_onto(call, head, now=now, max_wait=max_wait, manager=manager,
                                 clock=clock, sleep=sleep, confirm_s=confirm_s)
    finally:
        release_deploy_lock(lock_path, me)
    return code


def operator_deploy_refusal(call, after_turn: bool, skip_tests: bool) -> str:
    """Why the operator may not deploy now, or "" if it may.

    Its deploys are the routine kind only: after its own turn, with the full
    suite, when main is ahead of what is running, and with nothing else
    running for the restart to interrupt. Anything else is yours to decide.
    """
    if not after_turn:
        return "only `deploy --after-turn`"
    if skip_tests:
        return "not with --skip-tests"
    st = call("/status", {}) or {}
    rev = st.get("revision") or {}
    if not st.get("online"):
        return "the bot did not answer, so whether anything is running is unknown"
    if rev.get("state") != "stale" or not (rev.get("behind") or 0) > 0:
        return (f"main is not ahead of the running revision "
                f"({rev.get('state') or 'unknown'}); there is nothing to deploy")
    running = (call("/tasks", {"action": "list", "state": "running"}) or {})
    if "tasks" not in running:
        return "could not list running tasks"
    me = os.environ.get("SILKWORM_THREAD", "")
    others = [t.get("id") for t in running["tasks"] if not me or t.get("thread") != me]
    if others:
        return f"{len(others)} task(s) still running ({', '.join(map(str, others[:5]))})"
    return ""


def deploy_onto(call, head: str, *, now: bool, max_wait: float, manager=None,
                clock=time.monotonic, sleep=time.sleep,
                confirm_s: float = DEPLOY_CONFIRM_S, ignore=(),
                before_restart=None) -> tuple[int, str]:
    """Drain, wait for quiet, restart, confirm `head` is what runs.

    (exit status, why it failed or ""). The one implementation of a deploy:
    `deploy` runs it in the terminal, `deploy --after-turn` in the process it
    hands off to. `ignore` is task ids the wait may pass over once no live
    process holds them -- the turn that asked for an after-turn deploy, whose
    record can lag its process by a moment and must not hold this forever.
    `before_restart`, given, says why not to restart after all ("" to go on).
    """
    drained = False
    drain_s = max_wait + DEPLOY_DRAIN_MARGIN_S
    status = call("/status", {})
    if not status.get("online"):
        # Nothing answering means nothing running to protect.
        print(f"  {Y}·{N} the bot is not answering — nothing to drain, starting it")
    else:
        r = call("/drain", {"action": "start", "seconds": drain_s, "why": "deploy"})
        if r.get("ok") and r.get("draining"):
            drained = True
            print(f"  {G}✔{N} draining: the runner claims nothing new "
                  f"(lapses on its own in {int(drain_s // 60)}m)")
        elif now:
            print(f"  {Y}·{N} could not drain (this bot predates it) — restarting anyway (--now)")
        else:
            print(f"  {R}✘{N} could not drain: the running bot does not know how "
                  f"(too old) — use --now to restart regardless, or silkworm restart")
            return 1, "the running bot could not drain (too old) — deploy from a terminal with --now"

    try:
        if drained and not now:
            print(f"  {Y}·{N} waiting for {DEPLOY_QUIET_S}s with nothing running "
                  f"(gives up after {int(max_wait // 60)}m)…")
            ok, rows = wait_for_quiet(call, max_wait=max_wait, drain_s=drain_s,
                                      clock=clock, sleep=sleep, ignore=ignore)
            if not ok:
                call("/drain", {"action": "stop"})
                print(f"  {R}✘{N} still busy after {int(max_wait // 60)}m — not restarting; "
                      f"drain lifted. Still running:")
                for row in rows[:12]:
                    print(f"      {busy_line(row)}")
                return 1, (f"still busy after {int(max_wait // 60)}m, so it did not restart "
                           f"(drain lifted): " + "; ".join(busy_line(r) for r in rows[:4]))
            print(f"  {G}✔{N} nothing running")
        elif drained:
            rows = call("/drain", {"action": "status"}).get("running") or []
            if rows:
                print(f"  {Y}·{N} --now: interrupting {len(rows)} running "
                      f"(queued work resumes its session after the restart):")
                for row in rows[:12]:
                    print(f"      {busy_line(row)}")
    except KeyboardInterrupt:
        if drained:
            call("/drain", {"action": "stop"})
        print(f"\n  {Y}·{N} interrupted — not restarting; drain lifted")
        return 130, "interrupted before restarting; drain lifted"
    except SystemExit:
        # Stopped (SIGTERM in the detached deploy): the drain must not
        # outlive us by hours.
        if drained:
            call("/drain", {"action": "stop"})
        print(f"\n  {Y}·{N} stopped — not restarting; drain lifted")
        raise

    if before_restart:
        stop = before_restart()
        if stop:
            if drained:
                call("/drain", {"action": "stop"})
            print(f"  {R}✘{N} {stop} — drain lifted")
            return 1, stop + "; drain lifted"

    mgr = manager or service_manager()
    if not mgr.restart():
        # A restart can fail before stopping anything (a missing plist) or
        # leave the old process holding its port. Either way the old bot may
        # still be the one running, and it must not stay drained for hours.
        if drained and call("/drain", {"action": "stop"}).get("ok"):
            print(f"  {Y}·{N} the old bot is still answering — drain lifted")
        print(f"  {R}✘{N} restart failed — see above; silkworm logs")
        return 1, "the restart failed"

    why: list = []
    if confirm_deploy(call, head, confirm_s=confirm_s, clock=clock, sleep=sleep, why=why):
        return 0, ""
    return 1, "; ".join(why) or "the restarted bot could not be confirmed"


def confirm_deploy(call, head: str, *, confirm_s: float = DEPLOY_CONFIRM_S,
                   clock=time.monotonic, sleep=time.sleep, why=None) -> bool:
    """That the bot came back, reconnected, and is running `head`.

    Each failed check's reason is appended to `why`, when given, for whoever
    has to say what went wrong somewhere other than this terminal.
    """
    why = [] if why is None else why
    deadline = clock() + confirm_s
    st: dict = {}
    while True:
        st = call("/status", {}) or {}
        up = bool(st.get("online"))
        linked = bool((st.get("slack") or {}).get("connected"))
        started = (st.get("revision") or {}).get("started") or ""
        if (up and linked and started == head) or clock() >= deadline:
            break
        sleep(2)

    def need(label, ok, hint, reason=None):
        if not ok and reason != "":
            why.append(reason or hint)
        return check(label, ok, hint)
    ok = need(f"bot reachable on :{bot_port()}", up, "silkworm logs may say why",
              "the bot never answered after the restart")
    ok &= need("connected to slack", up and linked,
               f"not connected after {int(confirm_s)}s — silkworm logs",
               f"not connected to Slack after {int(confirm_s)}s" if up else "")
    if not up:
        ok &= need("running revision", False, "the bot never answered", "")
    elif not started:
        ok &= need("running revision", False, "the bot did not report one",
                   "the bot did not report its revision")
    else:
        ok &= need(f"running {started[:8]}, the checkout's HEAD", started == head,
                   f"running {started[:8]}, but HEAD is {head[:8]}")
    return ok


# --- deploy --after-turn: the same deploy, from inside a turn ----------------------
#
# A turn cannot deploy itself: it would wait on its own turn, then the restart
# kills it. Until now that was got round with a hand-rolled double fork. This
# is that, supported: the checks run here, where a failure can still be read,
# and the rest is handed to a process that belongs to nobody -- not the bot,
# not the claude running the turn -- so the restart cannot take it down too.

#: Hidden subcommand the handoff runs. Not for typing.
AFTER_TURN_CMD = "_deploy-after-turn"
#: One deploy at a time: held from the checks until the outcome is posted.
AFTER_TURN_LOCK = LOGS / "deploy-after-turn.lock"
#: Where the detached process writes everything it would have printed.
AFTER_TURN_LOG = LOGS / "deploy-after-turn.log"
#: The calling turn gets this long to finish. Not --max-wait: that bounds the
#: wait on *other* work, which the turn asking is not.
AFTER_TURN_CALLER_S = 6 * 3600
#: Variables the handoff keeps of the SILKWORM_* family: where the bot and the
#: visualizer listen. The rest describe the turn, which the deploy is not.
_KEEP_ENV = ("SILKWORM_BOT_PORT", "SILKWORM_VIZ_PORT")


def deploy_pid_alive(pid: int) -> bool:
    """Whether `pid` is a live deploy -- by its command line, not just its
    number, which the OS hands out again."""
    try:
        os.kill(pid, 0)
    except ProcessLookupError:
        return False
    except PermissionError:
        pass
    except OSError:
        return False
    try:
        r = subprocess.run(["ps", "-o", "command=", "-p", str(pid)],
                           capture_output=True, text=True, timeout=10)
    except (OSError, subprocess.SubprocessError):
        return True     # cannot tell: a deploy we cannot see is still a deploy
    return "silkworm" in r.stdout and "deploy" in r.stdout


class _LockGuard:
    """flock on a file beside the lock, so read-decide-write on the lock is one
    step: two callers finding the same stale lock cannot both take it over, and
    nobody reads one half-written."""

    def __init__(self, path: Path):
        self.path = path.with_name(path.name + ".guard")

    def __enter__(self):
        import fcntl
        self.path.parent.mkdir(parents=True, exist_ok=True)
        self.fd = os.open(str(self.path), os.O_CREAT | os.O_RDWR, 0o644)
        fcntl.flock(self.fd, fcntl.LOCK_EX)
        return self

    def __exit__(self, *exc):
        os.close(self.fd)           # closing drops the flock
        return False


def _read_lock(path: Path) -> dict:
    try:
        held = json.loads(path.read_text() or "{}")
    except (OSError, ValueError):
        return {}
    return held if isinstance(held, dict) else {}


def take_deploy_lock(path: Path, record: dict, alive=deploy_pid_alive):
    """Hold the one-deploy lock. None if taken; else the record holding it.

    A lock whose process is gone is stale -- a deploy killed part-way -- and
    is taken over.
    """
    with _LockGuard(path):
        if path.exists():
            held = _read_lock(path)
            pid = held.get("pid")
            if pid and alive(int(pid)):
                return held
        write_deploy_lock(path, record)
        return None


def write_deploy_lock(path: Path, record: dict) -> None:
    tmp = path.with_name(f"{path.name}.{os.getpid()}.tmp")
    tmp.write_text(json.dumps(record))
    os.replace(tmp, path)


def pass_deploy_lock(path: Path, frm: int, record: dict) -> bool:
    """Rewrite the lock as `record` if `frm` still holds it."""
    with _LockGuard(path):
        if _read_lock(path).get("pid") != frm:
            return False
        write_deploy_lock(path, record)
        return True


def release_deploy_lock(path: Path, pid: int) -> None:
    """Drop the lock if it is `pid`'s. A lock someone else took over (ours was
    judged stale) is theirs to drop."""
    with _LockGuard(path):
        if path.exists() and _read_lock(path).get("pid") in (None, pid):
            try:
                path.unlink()
            except FileNotFoundError:
                pass


def detach(argv: list, env: dict, log_path: Path, cwd: Path = REPO) -> int:
    """Run `argv` belonging to nobody. Returns its pid.

    A double fork with setsid between: the first child starts a new session and
    forks again, then exits, so the process that execs is reparented to PID 1
    straight away -- not a child of this CLI, of the claude running the turn or
    of the bot, and outside their process groups, so neither a restart nor a
    Bash tool timeout signalling the group reaches it. stdin is /dev/null;
    stdout and stderr append to `log_path`.
    """
    log_path.parent.mkdir(parents=True, exist_ok=True)
    r, w = os.pipe()
    pid = os.fork()
    if pid == 0:                                   # first child
        try:
            os.close(r)
            os.setsid()
            pid2 = os.fork()
            if pid2 == 0:                          # the one that runs
                try:
                    os.close(w)
                    os.chdir(str(cwd))
                    nul = os.open(os.devnull, os.O_RDONLY)
                    out = os.open(str(log_path), os.O_WRONLY | os.O_CREAT | os.O_APPEND, 0o644)
                    os.dup2(nul, 0)
                    os.dup2(out, 1)
                    os.dup2(out, 2)
                    os.closerange(3, 4096)
                    os.execve(argv[0], list(argv), env)
                finally:
                    os._exit(127)
            os.write(w, str(pid2).encode())
        finally:
            os._exit(0)
    os.close(w)
    data = b""
    while True:
        chunk = os.read(r, 64)
        if not chunk:
            break
        data += chunk
    os.close(r)
    os.waitpid(pid, 0)
    return int(data or b"0")


def handoff_env(env=None) -> dict:
    """The environment the detached deploy gets: the caller's, without the
    variables that make a process a turn -- its thread, role, task and git
    guard. It is passed what it needs on its command line instead."""
    env = dict(os.environ if env is None else env)
    for k in list(env):
        if k.startswith("SILKWORM_") and k not in _KEEP_ENV:
            del env[k]
    return env


def report_pending(held: dict, head: str, log_path: Path) -> int:
    """Say which deploy holds the lock. 0 if it deploys `head` anyway, else 1."""
    other = held.get("head") or ""
    print(f"  {Y}·{N} a deploy is already pending — not starting another: "
          f"pid {held.get('pid', '?')}, {held.get('stage', 'starting')}, "
          f"of {other[:8] or '?'}"
          + (f", for thread {held['thread']}" if held.get("thread") else "")
          + f"; log {held.get('log') or log_path}")
    if other and other == head:
        return 0
    print(f"  {R}✘{N} it deploys {other[:8] or 'another commit'}, not this checkout's "
          f"{head[:8]} — run this again once it has finished")
    return 1


def deploy_after_turn(repo: Path, *, skip_tests: bool, max_wait: float, git, suite,
                      handoff, lock_path: Path, log_path: Path, alive) -> int:
    """Check now, then hand the deploy to a detached process. Exit status.

    The checks run in the foreground so a failure is seen by the turn that
    asked. Only one deploy at a time: asked again while one is pending, this
    says which and starts nothing.
    """
    thread = os.environ.get("SILKWORM_THREAD", "")
    task = os.environ.get("SILKWORM_TASK_ID", "")
    code, head = git(repo, "rev-parse", "HEAD")
    if code != 0 or not head:
        print(f"  {R}✘{N} could not resolve HEAD")
        return 1
    me = os.getpid()
    held = take_deploy_lock(lock_path, {"pid": me, "stage": "checking", "head": head,
                                        "thread": thread, "log": str(log_path),
                                        "started": time.time()}, alive=alive)
    if held is not None:
        return report_pending(held, head, log_path)
    pid = 0
    try:
        problems = deploy_preflight(repo, skip_tests, git=git, suite=suite)
        for p in problems:
            print(f"  {R}✘{N} {p}")
        if problems:
            release_deploy_lock(lock_path, me)
            return 1
        print(f"  {G}✔{N} checkout is clean on its base branch"
              + (" (tests skipped)" if skip_tests else ", tests pass"))
        code, now_head = git(repo, "rev-parse", "HEAD")
        if code != 0 or now_head != head:
            print(f"  {R}✘{N} HEAD moved during the checks ({head[:8]} → {now_head[:8]}) — run it again")
            release_deploy_lock(lock_path, me)
            return 1
        argv = [sys.executable, str(Path(__file__).resolve()), AFTER_TURN_CMD,
                "--head", head, "--thread", thread, "--task", task,
                "--max-wait", str(int(max_wait)),
                "--lock", str(lock_path), "--log", str(log_path)]
        pid = handoff(argv, handoff_env(), log_path)
        if not pid:
            print(f"  {R}✘{N} could not start the detached deploy")
            release_deploy_lock(lock_path, me)
            return 1
        pass_deploy_lock(lock_path, me, {"pid": pid, "stage": "waiting for the turn to end",
                                         "head": head, "thread": thread,
                                         "log": str(log_path), "started": time.time()})
    except BaseException:
        if pid:
            # Handed off already: the lock is the detached deploy's, not ours to drop.
            pass_deploy_lock(lock_path, me, {"pid": pid, "stage": "waiting for the turn to end",
                                             "head": head, "thread": thread,
                                             "log": str(log_path), "started": time.time()})
        else:
            release_deploy_lock(lock_path, me)
        raise
    print(f"  {G}✔{N} handed off to pid {pid}, detached: once this turn has ended and "
          f"{DEPLOY_QUIET_S}s pass with nothing running, it drains, restarts onto "
          f"{head[:8]} and confirms it")
    print(f"  {Y}·{N} the outcome is posted "
          + ("to this thread" if thread else "nowhere (no thread) — read the log")
          + f"; log {log_path}")
    return 0


def wait_for_caller(call, thread: str, task: str, *, limit: float = AFTER_TURN_CALLER_S,
                    clock=time.monotonic, sleep=time.sleep, poll_s: float = 5,
                    progress_s: float = DEPLOY_PROGRESS_S) -> tuple[bool, set]:
    """Wait for the turn that asked for the deploy to end. (ended, its ids).

    The turn is whatever was running for the caller's task, or on its thread,
    when first seen -- fixed then, so a later turn on the same thread is other
    work, waited on (not ignored) like any. It has ended once no live process
    holds it: a record that still says running after its process is gone is
    the bot catching up, or an orphan, and either way not worth waiting for.
    """
    start = clock()
    ids: set = set()
    seen = False
    last_said = None
    while True:
        now = clock()
        r = call("/drain", {"action": "status"})
        if r.get("ok"):
            rows = [row for row in (r.get("running") or []) if row.get("kind", "task") == "task"]
            if not seen:
                ids = {row.get("id") for row in rows
                       if (task and row.get("id") == task)
                       or (thread and row.get("thread") == thread)}
                seen = True
            if not any(row.get("id") in ids and row.get("live", True) for row in rows):
                return True, ids
        if now - start >= limit:
            return False, ids
        if last_said is None or now - last_said >= progress_s:
            print(f"  {Y}·{N} {int(now - start)}s: "
                  + ("waiting for the calling turn to end" if r.get("ok")
                     else "the bot is not answering — waiting"))
            last_said = now
        sleep(poll_s)


def report_outcome(call, thread: str, text: str, *, outbox: Path,
                   sleep=time.sleep, tries: int = 3) -> str:
    """Tell the calling thread. Where it went: thread, outbox or log.

    Through the bot when it answers; a bot that never came back cannot post,
    so the note goes in the thread's outbox, which the bot uploads to the
    thread at the end of its next turn there.
    """
    print(text)
    if not thread:
        return "log"
    for n in range(tries):
        if (call("/tell", {"key": thread, "text": text}) or {}).get("ok"):
            return "thread"
        if n + 1 < tries:
            sleep(10)
    try:
        box = outbox / thread.replace(":", "__")
        box.mkdir(parents=True, exist_ok=True)
        note = box / f"deploy-{time.strftime('%Y%m%d-%H%M%S')}.txt"
        note.write_text(text + "\n")
        print(f"  {Y}·{N} the bot did not take the message — left in {note}")
        return "outbox"
    except OSError as e:
        print(f"  {R}✘{N} could not leave it in the outbox either: {e}")
        return "log"


def still_checked(repo: Path, head: str, git=git_out) -> str:
    """Why the checkout is no longer what the checks passed, or "".

    The checks ran before the wait; a turn can commit, or a landing move the
    base, while it waits. The restart loads whatever is checked out, so a
    moved HEAD would put code nobody tested into the bot -- and then the
    revision check would call a working restart a failure.
    """
    code, now = git(repo, "rev-parse", "HEAD")
    if code != 0 or not now:
        return "could not resolve HEAD before restarting"
    if now != head:
        return (f"HEAD moved from {head[:8]} to {now[:8]} after the checks, so it did "
                f"not restart onto unchecked code — run deploy --after-turn again")
    code, dirty = git(repo, "status", "--porcelain", "--untracked-files=no")
    if code != 0:
        return "could not read git status before restarting"
    if dirty:
        return "tracked files changed after the checks, so it did not restart onto them"
    return ""


def after_turn_run(head: str, thread: str, task: str, max_wait: float, *, call,
                   manager=None, lock_path: Path, log_path: Path, outbox: Path,
                   clock=time.monotonic, sleep=time.sleep,
                   confirm_s: float = DEPLOY_CONFIRM_S,
                   caller_s: float = AFTER_TURN_CALLER_S,
                   repo: Path = REPO, git=git_out) -> int:
    """What the detached process does: wait for the caller, deploy, say how it
    went, let go of the lock. Exit status."""
    me = os.getpid()
    code, why = 1, "it was stopped before finishing (a drain it held was lifted)"
    try:
        print(f"{WORM} deploy after turn {time.strftime('%Y-%m-%d %H:%M:%S')} pid {me} "
              f"of {head[:8]} for {thread or 'no thread'}")
        ended, ids = wait_for_caller(call, thread, task, limit=caller_s,
                                     clock=clock, sleep=sleep)
        if not ended:
            code, why = 1, (f"the calling turn was still running after "
                            f"{int(caller_s // 60)}m, so it did not restart")
        else:
            print(f"  {G}✔{N} the calling turn has ended")
            try:
                pass_deploy_lock(lock_path, me, {"pid": me, "stage": "deploying", "head": head,
                                                 "thread": thread, "log": str(log_path),
                                                 "started": time.time()})
            except OSError:
                pass
            code, why = deploy_onto(call, head, now=False, max_wait=max_wait,
                                    manager=manager, clock=clock, sleep=sleep,
                                    confirm_s=confirm_s, ignore=ids,
                                    before_restart=lambda: still_checked(repo, head, git))
    except Exception as e:
        code, why = 1, f"{type(e).__name__}: {e}"
    finally:
        if code == 0:
            text = (f":rocket: Deployed: the bot is running `{head[:8]}`, the HEAD "
                    f"this deploy was launched for. Log: `{log_path}`")
        else:
            text = f":x: Deploy of `{head[:8]}` did not complete: {why}. Log: `{log_path}`"
        try:
            report_outcome(call, thread, text, outbox=outbox, sleep=sleep)
        finally:
            release_deploy_lock(lock_path, me)
    return code


def do_after_turn_detached(argv) -> int:
    """Entry point of the handed-off process. See deploy_after_turn."""
    opts = {"--head": "", "--thread": "", "--task": "", "--max-wait": str(DEPLOY_MAX_WAIT_S),
            "--lock": str(AFTER_TURN_LOCK), "--log": str(AFTER_TURN_LOG)}
    i = 0
    while i + 1 < len(argv) and argv[i] in opts:
        opts[argv[i]] = argv[i + 1]
        i += 2
    if i != len(argv) or not opts["--head"]:
        print(f"usage: silkworm {AFTER_TURN_CMD} --head SHA [--thread K] [--task ID] ... "
              f"(started by deploy --after-turn, not by hand)")
        return 2
    import signal
    # A stop (launchd, kill) still says so in the thread, and lets go of the lock.
    signal.signal(signal.SIGTERM, lambda *_: sys.exit(143))
    return after_turn_run(opts["--head"], opts["--thread"], opts["--task"],
                          float(opts["--max-wait"]),
                          call=lambda path, payload: bot_call(path, payload, timeout=10),
                          lock_path=Path(opts["--lock"]), log_path=Path(opts["--log"]),
                          outbox=REPO / "outbox")


def do_launch(args: list[str]) -> None:
    cwd = os.getcwd()
    title_parts = []
    i = 0
    while i < len(args):
        if args[i] == "--dir" and i + 1 < len(args):
            cwd = str(Path(args[i + 1]).expanduser().resolve())
            i += 2
        else:
            title_parts.append(args[i])
            i += 1
    title = " ".join(title_parts) or Path(cwd).name

    session_id = str(uuid.uuid4())
    answer = bot_call("/register-terminal",
                      {"session_id": session_id, "cwd": cwd, "title": title}, timeout=3)
    if answer.get("ok"):
        print(f"{WORM} thread anchored in Slack → {answer['link']}")
    else:
        print(f"{WORM} untracked session ({answer.get('error', 'bot not reachable')})")

    os.chdir(cwd)
    os.execvp("claude", ["claude", "--session-id", session_id])


def main() -> None:
    args = sys.argv[1:]
    cmd = args[0] if args else ""
    if cmd == "import":
        print(f"{WORM} importing running claude sessions…")
        do_import()
    elif cmd == "harvest":
        print(f"{WORM} harvesting learnings from new session activity…")
        r = bot_call("/learnings", {"action": "harvest"}, timeout=600)
        if r.get("ok"):
            print(f"  {G}✔{N} {r.get('scanned', 0)} sessions scanned · "
                  f"{r.get('added', 0)} new learnings")
        else:
            print(f"  {R}✘{N} {r.get('error', 'bot unreachable — is it running?')}")
    elif cmd == "summarize":
        force = "--force" in args
        print(f"{WORM} summarizing thread context"
              f"{' (all threads)' if force else ' (missing only)'}…")
        r = bot_call("/summaries", {"force": force}, timeout=1800)
        if r.get("ok"):
            print(f"  {G}✔{N} {r.get('summarized', 0)} summarized · "
                  f"{r.get('skipped', 0)} skipped · {r.get('failed', 0)} failed")
        else:
            print(f"  {R}✘{N} {r.get('error', 'bot unreachable — is it running?')}")
    elif cmd == "tasks":
        state = args[1] if len(args) > 1 else ""
        r = bot_call("/tasks", {"action": "list", "state": state} if state
                     else {"action": "attention"}, timeout=10)
        if not r.get("ok"):
            print(f"  {R}✘{N} {r.get('error', 'bot unreachable — is it running?')}")
        else:
            items = r["tasks"]
            print(f"{WORM} {state or 'needs you'} — {len(items)} task(s)")
            for t in items:
                print(f"  {t['state']:18} {t['id']}  {t['title'][:52]}")
            counts = r.get("counts") or {}
            if counts:
                print("  " + " · ".join(f"{k}:{v}" for k, v in sorted(counts.items())))
    elif cmd == "watching":
        r = bot_call("/tasks", {"action": "watching"})
        rows = r.get("watching") or []
        print(f"{WORM} watching — {len(rows)} scheduled wake-up(s)")
        for w in rows:
            ago = -w["in_s"]
            when = ((f"LATE {ago // 60}m" if ago >= 60 else f"LATE {ago}s")
                    if w.get("late") else
                    "due now" if w["in_s"] <= 0 else
                    f"in {w['in_s']}s" if w["in_s"] < 90 else
                    f"in {round(w['in_s'] / 60)}m" if w["in_s"] < 5400 else
                    f"in {w['in_s'] / 3600:.1f}h")
            print(f"  {when:>9}  {w['id']}  {w['goal'][:64]}")
            print(f"             thread {w['thread']} · "
                  f"check {w['depth']} of {w['depth'] + w['remaining']}")
        if not rows:
            print("  nothing scheduled")
        late = [w for w in rows if w.get("late")]
        if late:
            print(f"  {R}✘{N} {len(late)} wake-up(s) due and not yet claimed — "
                  "silkworm status says whether the wake lane is alive")
    elif cmd == "task":
        do_file_task(args[1:])   # args[0] is the subcommand
    elif cmd == "defer":
        do_defer(args[1:])          # args[0] is the subcommand itself
    elif cmd == "email":
        print(f"{WORM} scanning Gmail…")
        r = bot_call("/tasks", {"action": "ingest-email"}, timeout=600)
        if r.get("ok"):
            print(f"  {G}✔{N} {r.get('scanned', 0)} new message(s) · "
                  f"{r.get('proposed', 0)} proposed for triage")
        else:
            print(f"  {R}✘{N} {r.get('error', 'bot unreachable — is it running?')}")
    elif cmd == "test":
        print(f"{WORM} running regression tests…")
        py = str(VENV_PY) if VENV_PY.exists() else sys.executable
        sys.exit(subprocess.run([py, str(REPO / "tests" / "test_invariants.py")]).returncode)
    elif cmd == "discard":
        # The way to reset a backlog. Doing it with `git branch -D` is how
        # fifteen commits ended up reachable from nothing on 2026-09-12, with a
        # note claiming a reflog that had never held them.
        sys.path.insert(0, str(REPO))
        import discard as _discard
        # args[0] is "discard" itself -- the classic off-by-one, which
        # here would have tried to delete a branch called "discard".
        branches = [a for a in args[1:] if not a.startswith("-")]
        repo = Path.cwd()
        if not branches:
            print("usage: silkworm discard <branch>... "
                  "(run from the repository they are in)")
            sys.exit(2)
        print(f"{WORM} discarding {len(branches)} branch(es) from {repo}…")
        for line in _discard.reset(repo, branches):
            print(f"  {G}·{N} {line}")
        print(f"  recover any of them with: git checkout -b <branch> <tag>")

    elif cmd == "artifacts":
        # Read-only: the report behind ARTIFACT_PRUNE, so turning it on can be
        # decided from numbers. The sweeper does the removing, not this.
        sys.path.insert(0, str(REPO))
        import artifacts as _artifacts
        import jsonstore as _jsonstore
        days = 30.0
        if "--days" in args:
            try:
                days = float(args[args.index("--days") + 1])
            except (IndexError, ValueError):
                print("usage: silkworm artifacts [--days N]")
                sys.exit(2)
        try:
            sessions = _jsonstore.load(REPO / "sessions.json", default={}, repair=False)
        except _jsonstore.CorruptStore as exc:
            # Without the records every file would read as unreferenced.
            print(f"{WORM} cannot read sessions.json — {exc}")
            sys.exit(1)
        doomed = _artifacts.plan(REPO / "artifacts", sessions, days)
        print(f"{WORM} artifacts retention at {days:g} days would remove "
              f"{_artifacts.summary(doomed)}")
        per: dict = {}
        for item in doomed:
            d = Path(item["path"]).parent.name
            per[d] = per.get(d, 0) + item["size"]
        for d, size in sorted(per.items(), key=lambda kv: -kv[1]):
            print(f"  {size / 1e6:8.1f}MB  {d}")
    elif cmd == "titles":
        force = "--force" in args
        print(f"{WORM} naming threads{' (all)' if force else ' (untitled only)'}…")
        r = bot_call("/titles", {"force": force}, timeout=1800)
        if r.get("ok"):
            print(f"  {G}✔{N} {r.get('titled', 0)} named · {r.get('skipped', 0)} skipped")
        else:
            print(f"  {R}✘{N} {r.get('error', 'bot unreachable — is it running?')}")
    elif cmd == "learnings":
        sub = args[1] if len(args) > 1 else ""
        lf = learnings_file()
        if sub == "init":
            import learnings_git
            r = learnings_git.init(lf, args[2] if len(args) > 2 else "")
            if r.get("ok"):
                print(f"  {G}✔{N} learnings git repo ready at {r['dir']}")
                if lf != DEFAULT_LEARNINGS:
                    print(f"  add to .env:  LEARNINGS_FILE={lf}")
                else:
                    print(f"  {Y}note:{N} sharing works best with LEARNINGS_FILE pointing at a "
                          f"dedicated dir; see README.")
                print("  then: silkworm learnings sync")
            else:
                print(f"  {R}✘{N} {r.get('error')}")
        elif sub == "sync":
            r = bot_call("/learnings", {"action": "sync"}, timeout=60)
            mark = f"{G}✔{N}" if r.get("ok") else f"{R}✘{N}"
            print(f"  {mark} {r.get('note') or r.get('error') or 'bot unreachable'}")
        else:
            print("usage: silkworm learnings [init [remote] | sync]")
    elif cmd == "setup":
        do_setup()
    elif cmd == "doctor":
        sys.exit(0 if do_doctor() else 1)
    elif cmd == "install":
        LOGS.mkdir(exist_ok=True)
        sys.exit(0 if service_manager().install() else 1)
    elif cmd == "uninstall":
        service_manager().uninstall()
    elif cmd == "restart":
        sys.exit(0 if service_manager().restart() else 1)
    elif cmd == "deploy":
        sys.exit(do_deploy(args[1:]))   # args[0] is the subcommand itself
    elif cmd == AFTER_TURN_CMD:
        # Not for typing: what `deploy --after-turn` hands off to.
        sys.exit(do_after_turn_detached(args[1:]))
    elif cmd == "status":
        if "--json" in args[1:]:          # args[0] is the subcommand itself
            sys.exit(do_status_json())
        do_status()
    elif cmd in TASK_ACTIONS:
        sys.exit(do_task_action(cmd, args[1:]))   # args[0] is the subcommand
    elif cmd == "operator":
        sys.exit(do_operator(args[1:]))           # args[0] is the subcommand
    elif cmd == "tailscale":
        sys.exit(do_tailscale(args[1:]))          # args[0] is the subcommand
    elif cmd == "logs":
        os.execvp("tail", ["tail", "-n", "40", "-f", str(LOGS / "bot.log")])
    elif cmd in ("help", "-h", "--help"):
        print(__doc__.strip())
    else:
        do_launch(args)


if __name__ == "__main__":
    main()
