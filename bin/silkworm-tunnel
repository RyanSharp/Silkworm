#!/usr/bin/env bash
# silkworm-tunnel — keep an SSH tunnel to the Silkworm dashboard open.
#
# Run this on the machine you BROWSE FROM (your laptop), not on the Mac mini
# that runs Silkworm. It installs a launchd agent that holds an SSH tunnel to
# the mini's dashboard port and re-dials whenever it drops — on wake from
# sleep, on Wi-Fi changes, on reboot — so http://127.0.0.1:8790 just works.
#
#   ./silkworm-tunnel install [user@]host     # default: Ryans-Mac-mini-2.local
#   ./silkworm-tunnel status
#   ./silkworm-tunnel uninstall
#
# The dashboard stays bound to loopback on the mini; nothing is exposed to the
# LAN. The tunnel's far end lands on the mini's own 127.0.0.1.
set -euo pipefail

LABEL="com.silkworm.tunnel"
PLIST="$HOME/Library/LaunchAgents/$LABEL.plist"
LOGDIR="$HOME/Library/Logs/silkworm"
PORT="${SILKWORM_VIZ_PORT:-8790}"
# The mini's LocalHostName is "Ryans-Mac-mini-2", so this is its real mDNS
# name. An earlier default of "Ryans-Mini-2.local" named nothing at all,
# which is why .local "did not work" -- it was never being asked for.
DEFAULT_HOST="Ryans-Mac-mini-2.local"
# Last resort when neither a name nor the cached address answers: find the host
# by the address it actually presents on the network.
#
# Note this is NOT the mini's hardware MAC (1c:f6:4c:76:e8:09). macOS Private
# Wi-Fi Address is on, so the router only ever sees a randomised address -- and
# a DHCP reservation made against the hardware MAC would silently never match.
# If Private Wi-Fi Address is turned off for this network, the hardware MAC
# becomes the right value here and this fallback stops being fragile.
DEFAULT_MAC="${SILKWORM_MAC:-d2:a8:29:0a:b8:bf}"
STATE="$HOME/.silkworm"
DIALER="$STATE/tunnel-dial"

Y=$'\033[33m'; G=$'\033[32m'; R=$'\033[31m'; N=$'\033[0m'
say() { printf '%s🪱 silkworm-tunnel:%s %s\n' "$Y" "$N" "$1"; }
ok()  { printf '  %s✔%s %s\n' "$G" "$N" "$1"; }
bad() { printf '  %s✘%s %s\n' "$R" "$N" "$1"; }

target() { printf '%s' "${1:-${SILKWORM_HOST:-$DEFAULT_HOST}}"; }

check_ssh() {
  local host="$1"
  # BatchMode: fail instead of prompting. A launchd agent has no terminal to
  # answer a password or passphrase prompt, so if this can't connect
  # unattended, the agent would silently never come up.
  if ssh -o BatchMode=yes -o ConnectTimeout=8 -o StrictHostKeyChecking=accept-new \
         "$host" true 2>/dev/null; then
    ok "key-based SSH to $host works without prompting"
    return 0
  fi
  bad "cannot SSH to $host without a prompt"
  cat <<EOF

  Set up key auth first (one time):

    ssh-keygen -t ed25519            # if you don't have a key yet
    ssh-copy-id $host                # authorise it on the mini

  If your key has a passphrase, store it so launchd can use it:

    ssh-add --apple-use-keychain ~/.ssh/id_ed25519

  and add to ~/.ssh/config:

    Host ${host%%.*}*
      UseKeychain yes
      AddKeysToAgent yes

EOF
  return 1
}

write_dialer() {
  local host="$1" mac="$2"
  mkdir -p "$STATE"
  # Config separately from code: the body is a quoted heredoc, so nothing in it
  # needs escaping and it cannot be mangled by expansion at install time.
  cat > "$STATE/tunnel.conf" <<CONFEOF
PORT="$PORT"
HOST="$host"
NAME="$DEFAULT_HOST"
MAC="$mac"
CONFEOF
  cat > "$DIALER" <<'DIALEOF'
#!/usr/bin/env bash
# Generated by silkworm-tunnel. Do not edit; re-run install instead.
#
# launchd used to exec ssh against a host fixed at install time, so a DHCP
# lease change broke the tunnel permanently and silently: every redial went to
# an address the mini no longer had. This runs on each dial and works out where
# the mini actually is before connecting.
set -uo pipefail
. "$HOME/.silkworm/tunnel.conf"
CACHE="$HOME/.silkworm/tunnel-host"
log() { printf '%s %s\n' "$(date '+%Y-%m-%d %H:%M:%S')" "$1" >&2; }

reachable() {
  ssh -o BatchMode=yes -o ConnectTimeout=6 -o StrictHostKeyChecking=accept-new \
      "$1" true 2>/dev/null
}

# Strip leading zeros from each octet: `arp -an` prints 1c:f6:4c:76:e8:9, not
# ...:09, so the two only compare equal in that form. macOS ships BWK awk,
# which has no strtonum, so this is done textually.
norm_mac() {
  printf '%s' "$1" | tr 'A-Z' 'a-z' | awk -F: '
    { for (i = 1; i <= NF; i++) {
        o = $i; sub(/^0+/, "", o); if (o == "") o = "0"
        printf "%s%s", o, (i < NF ? ":" : "")
      } }'
}

by_mac() {
  [ -n "${MAC:-}" ] || return 1
  local want self
  want="$(norm_mac "$MAC")"
  self="$(ipconfig getifaddr en0 2>/dev/null || ipconfig getifaddr en1 2>/dev/null)"
  [ -n "$self" ] || return 1
  # Nudge the subnet so the ARP table has an entry to read.
  ping -c 1 -t 1 "${self%.*}.255" >/dev/null 2>&1 || true
  arp -an 2>/dev/null | awk -v want="$want" '
    { ip = $2; gsub(/[()]/, "", ip)
      if (tolower($4) == want) { print ip; exit } }'
}

# Explicit name first, then whatever answered last time, then the hardware
# address. Whichever works is remembered for the next dial.
# Kept distinct from HOST: installing against a literal IP would otherwise
# throw away the name, which is the one candidate a DHCP change cannot break.
for candidate in "${HOST:-}" "${NAME:-}" "$(cat "$CACHE" 2>/dev/null)" "$(by_mac)"; do
  [ -n "$candidate" ] || continue
  if reachable "$candidate"; then
    printf '%s' "$candidate" > "$CACHE"
    log "dialing $candidate"
    exec ssh -N -T \
      -o ExitOnForwardFailure=yes -o ServerAliveInterval=30 \
      -o ServerAliveCountMax=3 -o StrictHostKeyChecking=accept-new \
      -o BatchMode=yes \
      -L "${PORT}:127.0.0.1:${PORT}" "$candidate"
  fi
  log "no answer from $candidate"
done

log "could not reach the mini as ${HOST:-?} / ${NAME:-?} / $(cat "$CACHE" 2>/dev/null) / MAC ${MAC:-unset}"
exit 1
DIALEOF
  chmod +x "$DIALER"
  ok "wrote $DIALER"
}


write_plist() {
  mkdir -p "$HOME/Library/LaunchAgents" "$LOGDIR"
  cat > "$PLIST" <<EOF
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>$LABEL</string>
  <key>ProgramArguments</key>
  <array>
    <string>$DIALER</string>
  </array>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>ThrottleInterval</key><integer>10</integer>
  <key>StandardOutPath</key><string>$LOGDIR/tunnel.log</string>
  <key>StandardErrorPath</key><string>$LOGDIR/tunnel.err.log</string>
</dict>
</plist>
EOF
  ok "wrote $PLIST"
}

load_agent() {
  launchctl bootout "gui/$(id -u)/$LABEL" 2>/dev/null || true
  launchctl bootstrap "gui/$(id -u)" "$PLIST"
  launchctl kickstart "gui/$(id -u)/$LABEL" 2>/dev/null || true
  ok "agent loaded (starts at login, re-dials on drop)"
}

wait_for_port() {
  for _ in $(seq 1 15); do
    if nc -z 127.0.0.1 "$PORT" 2>/dev/null; then return 0; fi
    sleep 1
  done
  return 1
}

case "${1:-install}" in
  install)
    host="$(target "${2:-}")"
    say "installing tunnel to $host (dashboard port $PORT)"
    check_ssh "$host" || exit 1
    write_dialer "$host" "$DEFAULT_MAC"
    write_plist
    load_agent
    if wait_for_port; then
      ok "tunnel up — open http://127.0.0.1:$PORT"
    else
      bad "port $PORT not listening yet — check $LOGDIR/tunnel.err.log"
      exit 1
    fi
    ;;
  status)
    if launchctl print "gui/$(id -u)/$LABEL" >/dev/null 2>&1; then
      ok "agent $LABEL is loaded"
    else
      bad "agent not loaded — run: $0 install"
    fi
    if [ -s "$STATE/tunnel-host" ]; then
      ok "last reached the mini at $(cat "$STATE/tunnel-host")"
    fi
    if nc -z 127.0.0.1 "$PORT" 2>/dev/null; then
      ok "port $PORT is listening"
      code=$(curl -s -o /dev/null -m 5 -w '%{http_code}' "http://127.0.0.1:$PORT/" || true)
      [ "$code" = "200" ] && ok "dashboard responding (HTTP 200)" \
                          || bad "port open but dashboard returned '${code:-no response}'"
    else
      bad "port $PORT is not listening — see $LOGDIR/tunnel.err.log"
    fi
    ;;
  uninstall)
    launchctl bootout "gui/$(id -u)/$LABEL" 2>/dev/null || true
    rm -f "$PLIST" "$DIALER"
    ok "tunnel agent removed"
    ;;
  *)
    sed -n '2,14p' "$0" | sed 's/^# \{0,1\}//'
    exit 1
    ;;
esac
