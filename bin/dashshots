#!/usr/bin/env python3
"""Screenshots of every dashboard view, on a phone and a laptop.

    bin/dashshots [--out DIR] [--views sessions,board,...] [--widths 375,430,1280]
                  [--source DIR] [--before DIR] [--wait 5] [--list]
    bin/dashshots --perf [--before DIR] [--perf-runs 3] [--widths 375,430]

Mobile Safari in an iOS Simulator for the phone widths (375: iPhone SE (3rd
generation), 430: iPhone 16 Plus), and WebKit itself (a WKWebView snapshot,
the engine desktop Safari uses) for the laptop width. Each view is opened by
URL -- the dashboard's own deep links, ?view= ?modal= ?thread= ?task= ?card= -- since
the simulator has no tap automation. Files are DIR/<view>-<width>.png.

--before DIR runs a second copy, of DIR's code (an export of main, say),
beside --source's, on the same data, and shoots each view in both, one right
after the other: DIR/<view>-<width>-before.png and -after.png, seconds apart,
so what changed between them is the code and not a live thread moving on.

Nothing here can change Silkworm's state. The dashboard is a copy of
--source's code run from a temp directory against a copy of sessions.json,
and the bot it talks to is a stand-in that passes only reads through to the
real bot (the task board, projects, roles, learnings) and refuses every
action; a release plan is a fixed sample, since a real one fetches origin.
Transcripts are read where they are, as the dashboard always does.

The trader views are fed tests/fixtures/trader_status_real.json (what
trader's status script really prints; --trader-fixture names another): the copy's
projects.json points the trader project at a stand-in checkout whose
scripts/trader_status.py "runs" by printing that fixture, so the dashboard's
own subprocess, cache and render path are what is photographed. With
--trader-live the copy points at the real trader checkout instead (its status
script only reads).

--deploy photographs a deploy landing while the app is open: Mobile Safari
loads a copy of --deploy-from's code (default: --source's) labelled "rev A",
goes to the background, the copy is stopped and --source's starts on the same
port labelled "rev B" (each label changes the page, so each is a revision of
its own), and Safari comes back -- resumed, not navigated, as the home-screen
app is when it is reopened from the app switcher. DIR/deploy-<width>-<run>-
1-open.png, -2-resumed.png, then -3-fresh.png after a plain navigation, the
control that says what the server was serving. Runs: "plain", and "draft",
which leaves words typed in a new thread's composer before the deploy; there
the page's update banner is tapped by the injected script (no tap automation)
and -2b-banner-tapped.png shows where that left the draft.

--perf measures instead of photographing: bin/perfprobe.js, injected into
the copy, reads the browser's paint timing and counts frames while the list,
the task panel, a board and the longest thread are scrolled along a fixed
path, and while a panel opens; with --before both copies run, alternating,
--perf-runs times each, into DIR/perf-<width>.json. Phone widths only: the
laptop's WKWebView is drawn offscreen, where no animation clock runs.

The simulators are this script's own ("Silkworm Shots 375" / "... 430",
made on first use) and are shut down at the end. It refuses to touch any
other device -- in particular "Cadence Test iPhone 17", which another
project's test runs use.
"""

import argparse
import json
import os
import shutil
import socket
import subprocess
import sys
import tempfile
import threading
import time
import urllib.request
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
from pathlib import Path
from urllib.parse import quote

REPO = Path(__file__).resolve().parent.parent
SWIFT_SRC = REPO / "bin" / "websnap.swift"
FORBIDDEN_DEVICES = {"Cadence Test iPhone 17"}
DEVICES = {375: ("Silkworm Shots 375", "iPhone SE (3rd generation)"),
           430: ("Silkworm Shots 430", "iPhone 16 Plus")}
DESKTOP = 1280
#: A thread key no session has: opened, it is an empty new thread.
NEW_THREAD = "D0SHOTS:0000000000.000000"

#: /tasks actions that only read (visualizer.READ_TASK_ACTIONS, plus nothing).
READ_TASKS = {"list", "attention", "counts", "board", "overview", "task", "unmerged",
              "holding", "roles", "watching", "inbox", "project", "page"}
READ_PROJECTS = {"list", "get", "unregistered"}
READ_LEARNINGS = {"list"}
#: Routes that only ever read: whether the bot is up, and a thread's live turn.
READ_ROUTES = {"/status", "/thread-state"}

#: The trader status document the trader views draw (visualizer /api/trader):
#: what trader's scripts/trader_status.py really prints (captured from trader
#: 8d47517). --trader-fixture names another, e.g. tests/fixtures/
#: trader_status.json, which carries every optional field the tabs can draw.
TRADER_FIXTURE = REPO / "tests" / "fixtures" / "trader_status_real.json"

#: A release plan to draw, shaped as releases.plan answers.
SAMPLE_PLAN = {
    "ok": True, "base": "main", "running": False, "blocked": "", "confirm": "sample",
    "targets": [
        {"target": "functions", "pending": 3, "last": "functions-v1.4.2", "ship": "deploy",
         "after": ["migrations"], "versions": {"patch": "1.4.3", "minor": "1.5.0", "major": "2.0.0"},
         "commits": ["a1b2c3d Reminders use the user's own calendar, not Gregorian",
                     "d4e5f6a create-group-invite returns a universal link",
                     "0f9e8d7 verify-transaction checks the whole certificate chain"]},
        {"target": "migrations", "pending": 1, "last": "migrations-v0.9.0", "ship": "deploy",
         "versions": {"patch": "0.9.1", "minor": "0.10.0", "major": "1.0.0"},
         "commits": ["9a8b7c6 completion_photos: owner-only delete policy"]},
        {"target": "app", "pending": 0, "last": "v1.1.0", "ship": "tag",
         "versions": {"patch": "1.1.1", "minor": "1.2.0", "major": "2.0.0"}, "commits": []}],
    "steps": [{"target": "migrations", "tag": "migrations-v0.9.1", "level": "patch", "commits": 1},
              {"target": "functions", "tag": "functions-v1.4.3", "level": "patch", "commits": 3}],
    "effects": ["supabase db push: 1 migration", "supabase functions deploy: 3 functions"],
}


def live_home() -> Path:
    """The checkout the running bot uses (the git common dir's parent)."""
    out = subprocess.run(["git", "-C", str(REPO), "rev-parse", "--git-common-dir"],
                         capture_output=True, text=True).stdout.strip()
    common = Path(out) if out else REPO / ".git"
    if not common.is_absolute():
        common = REPO / common
    return common.resolve().parent


def env_value(path: Path, name: str) -> str:
    try:
        for line in path.read_text().splitlines():
            line = line.strip()
            if line.startswith("export "):
                line = line[7:]
            k, _, v = line.partition("=")
            if k.strip() == name:
                return v.strip().strip('"').strip("'")
    except OSError:
        pass
    return ""


def free_port() -> int:
    with socket.socket() as s:
        s.bind(("127.0.0.1", 0))
        return s.getsockname()[1]


# --- the stand-in bot ----------------------------------------------------------

class Probe:
    """What the page's scroll probe (bin/scrollprobe.js) has said, and how far
    the harness has let it go: it waits at each phase for a photograph."""
    def __init__(self):
        self.lock = threading.Lock()
        self.log: list[dict] = []
        self.go = 0

    def reset(self):
        with self.lock:
            self.log, self.go = [], 0


PROBE = Probe()


def stand_in(real_port: str):
    class Bot(BaseHTTPRequestHandler):
        def log_message(self, *a):
            pass

        def _probe(self, body: bytes = b"") -> bool:
            # The page is another origin (the dashboard copy's port): a plain
            # GET it may read, and a no-cors POST it may send.
            if not self.path.startswith("/probe/"):
                return False
            if self.path == "/probe/log":
                try:
                    entry = json.loads(body or b"{}")
                except ValueError:
                    entry = {"phase": "garbled", "raw": body[:200].decode("utf-8", "replace")}
                with PROBE.lock:
                    PROBE.log.append(entry)
            with PROBE.lock:
                out = json.dumps({"go": PROBE.go}).encode()
            self.send_response(200)
            self.send_header("Content-Type", "application/json")
            self.send_header("Access-Control-Allow-Origin", "*")
            self.send_header("Cache-Control", "no-store")
            self.send_header("Content-Length", str(len(out)))
            self.end_headers()
            self.wfile.write(out)
            return True

        def do_POST(self):
            n = int(self.headers.get("Content-Length") or 0)
            if self.path.startswith("/probe/"):
                self._probe(self.rfile.read(n))
                return
            try:
                payload = json.loads(self.rfile.read(n) or b"{}")
            except ValueError:
                payload = {}
            action = payload.get("action", "list")
            allowed = {"/tasks": READ_TASKS, "/projects": READ_PROJECTS,
                       "/learnings": READ_LEARNINGS}.get(self.path)
            if self.path in READ_ROUTES:
                allowed, action = {action}, action
            if self.path == "/plan" and action == "show":
                answer = {"ok": True, "plan": sample_ops_plan()[1]}
            elif self.path == "/releases" and action == "plan":
                answer = SAMPLE_PLAN
            elif self.path == "/releases" and action == "status":
                answer = {"ok": True, "run": None}
            elif allowed is not None and action in allowed:
                answer = forward(real_port, self.path, payload)
                if (self.path == "/tasks" and action == "inbox" and not answer.get("ok")
                        and "unknown action" in str(answer.get("error") or "")):
                    # A running bot older than the inbox: built here instead,
                    # by this checkout's inbox.py, over the live state read
                    # only -- what the bot's own route would answer.
                    answer = local_inbox(real_port)
                if (self.path == "/tasks" and action == "project" and not answer.get("ok")
                        and "unknown action" in str(answer.get("error") or "")):
                    # A running bot older than the project page: built here
                    # by this checkout's board.py, over the live state read only.
                    answer = local_project(real_port, payload.get("project") or "")
                if (self.path == "/tasks" and action == "page" and not answer.get("ok")
                        and "unknown action" in str(answer.get("error") or "")):
                    # A running bot older than the task page: built here
                    # by this checkout's board.py, over the live state read only.
                    answer = local_task_page(real_port, payload.get("id") or "")
                if self.path == "/tasks" and action == "inbox":
                    answer = with_sample_plan(answer)
            else:
                answer = {"ok": False, "error": "screenshot harness: read-only"}
            body = json.dumps(answer).encode()
            self.send_response(200)
            self.send_header("Content-Type", "application/json")
            self.send_header("Content-Length", str(len(body)))
            self.end_headers()
            self.wfile.write(body)

        def do_GET(self):
            if self._probe():
                return
            self.send_response(404)
            self.end_headers()

    return Bot


_SAMPLE_OPS_PLAN: list = []


def sample_ops_plan() -> tuple[dict, dict]:
    """The sample plan (_sample_ops_plan), made once: the inbox's item and the
    plan's own read must name the same plan id, as the bot's do."""
    if not _SAMPLE_OPS_PLAN:
        _SAMPLE_OPS_PLAN.append(_sample_ops_plan())
    return _SAMPLE_OPS_PLAN[0]


def _sample_ops_plan() -> tuple[dict, dict]:
    """(raw plan, card): a fixed plan of ops in the operator's real thread, for
    its card -- the live one is usually spent, and a press here is refused.
    DASHSHOTS_PLAN=ran photographs it after Run selected: entry 1 ok, entry 2
    failed with its output, entry 3 not chosen."""
    sys.path.insert(0, str(REPO))
    import ops
    import operator_role
    try:
        thread = operator_role.State(live_home() / "operator.json", readonly=True).thread()
    except Exception:
        thread = ""
    st = operator_role.State(Path(tempfile.mkdtemp()) / "operator.json")
    st.set_thread(thread or "D0:0.0")
    rec = st.set_plan([
        {"name": "trader-env-set", "args": ["MOMENTUM_UNIVERSE", "pit"]},
        {"name": "tailscale-on", "args": []},
        {"name": "land", "args": ["tsk_5c1e0a9b21"], "guard": "trader-config",
         "summary": "lands silkworm/tsk_5c1e0a9b21 into main; changes trader's live config: "
                    "config/sleeves.toml"}], by="operator", thread=thread or "D0:0.0",
        now=time.time() - 40 * 60)
    if os.environ.get("DASHSHOTS_PLAN") == "ran":
        st.answer_plan_from_dashboard(rec["id"], [1, 2], by="owner@example.com")
        for n, res in ((1, {"state": "ok", "exit": 0, "tail": "MOMENTUM_UNIVERSE: static -> pit"}),
                       (2, {"state": "failed", "exit": 1,
                            "tail": "tailscale serve: this machine is not logged in to Tailscale "
                                    "(run `tailscale up`)"})):
            st.use_plan_entry(rec["id"], n, run_by="dashboard")
            st.set_entry_result(rec["id"], n, dict(res, at=time.time()))
    desc = {d["name"]: d["description"] for d in ops.describe()}
    return st.plan_view(), dict(operator_role.plan_card(st.plan_view(), desc), running=False)


def with_sample_plan(answer: dict) -> dict:
    """The inbox's answer with the sample plan's item, when it has no plan."""
    if not answer.get("ok"):
        return answer
    if any(i.get("kind") == "plan" for g in answer.get("groups") or [] for i in g.get("items") or []):
        return answer
    import inbox
    raw, _ = sample_ops_plan()
    item = inbox.plan_item(raw)
    if not item:
        return answer
    group = {"project": inbox.OPERATOR, "title": "The operator", "items": [item]}
    return dict(answer, groups=[group, *(answer.get("groups") or [])],
                count=(answer.get("count") or 0) + 1)


def local_inbox(real_port: str) -> dict:
    """The /tasks `inbox` answer, from tasks.json, projects.json, health.json
    and operator.json in the live checkout (each loaded read-only) and the
    real bot's own branch survey."""
    sys.path.insert(0, str(REPO))
    try:
        import health
        import health_probes  # noqa: F401  (registers the checks and their decisions)
        import inbox
        import operator_role
        home = live_home()
        tasks_ = json.loads((home / "tasks.json").read_text())
        projects = list(json.loads((home / "projects.json").read_text()).values())
        rows = health.HealthStore(home / "health.json", readonly=True).all()
        op = operator_role.State(home / "operator.json", readonly=True)
        survey = forward(real_port, "/tasks", {"action": "unmerged"}).get("unmerged") or []
        out = inbox.build(tasks_.values(), unmerged_rows=survey, plan=op.plan(),
                          health_rows=rows, operator_thread=op.thread() or "",
                          project_titles={p["slug"]: p.get("title") or p["slug"] for p in projects})
        return {"ok": True, **out}
    except Exception as e:
        return {"ok": False, "error": f"screenshot harness: could not build the inbox ({e})"}


def local_project(real_port: str, slug: str) -> dict:
    """The /tasks `project` answer, built as local_inbox builds the inbox:
    tasks.json, projects.json and health.json read-only, the real bot's own
    branch survey, and the project's release tags read from git."""
    sys.path.insert(0, str(REPO))
    try:
        import board
        import health
        import health_probes  # noqa: F401  (registers the checks and their decisions)
        import releases
        home = live_home()
        tasks_ = json.loads((home / "tasks.json").read_text())
        projects = json.loads((home / "projects.json").read_text())
        prec = projects.get(slug) or next((p for p in projects.values() if p.get("slug") == slug), None)
        if not prec:
            return {"ok": False, "error": f"unknown project {slug!r}"}
        rows = health.HealthStore(home / "health.json", readonly=True).all()
        survey = forward(real_port, "/tasks", {"action": "unmerged"}).get("unmerged") or []
        cwd = (prec.get("scope") or {}).get("cwd") or ""
        tags = releases.tags_since(cwd, time.time() - board.PAGE_DAYS * 86400) if cwd else []
        rel = board.release_status(cwd) if cwd else None

        class _Read:
            def get(self, tid):
                return tasks_.get(tid)

            def all(self):
                return tasks_
        page = board.project_page(prec, tasks_.values(), unmerged_rows=survey, health_rows=rows,
                                  release=rel, release_tags=tags,
                                  action_of=lambda r: health.action(r, _Read()))
        return {"ok": True, "page": page}
    except Exception as e:
        return {"ok": False, "error": f"screenshot harness: could not build the project page ({e})"}


def local_task_page(real_port: str, tid: str) -> dict:
    """The /tasks `page` answer, built as local_project builds a project's:
    tasks.json and projects.json read-only, the real bot's own branch survey,
    and the task's changes read from git through taskchanges (read-only)."""
    sys.path.insert(0, str(REPO))
    try:
        import board
        import taskchanges
        home = live_home()
        tasks_ = json.loads((home / "tasks.json").read_text())
        projects = json.loads((home / "projects.json").read_text())
        rec = tasks_.get(tid)
        if not rec:
            return {"ok": False, "error": "unknown task"}

        def scope_for(slug):
            p = projects.get(slug) or next((x for x in projects.values() if x.get("slug") == slug), {})
            return (p or {}).get("scope") or {}
        survey = forward(real_port, "/tasks", {"action": "unmerged"}).get("unmerged") or []
        changes = taskchanges.for_task(rec, scope_for=scope_for)
        prec = projects.get(rec.get("project") or "") or {}
        page = board.task_page(rec, tasks_.values(), unmerged_rows=survey, changes=changes,
                               project_title=prec.get("title") or "")
        return {"ok": True, "page": page}
    except Exception as e:
        return {"ok": False, "error": f"screenshot harness: could not build the task page ({e})"}


def forward(port: str, path: str, payload: dict) -> dict:
    req = urllib.request.Request(f"http://127.0.0.1:{port}{path}",
                                 data=json.dumps(payload).encode(),
                                 headers={"Content-Type": "application/json"}, method="POST")
    try:
        with urllib.request.urlopen(req, timeout=15) as r:
            return json.loads(r.read())
    except Exception as e:
        return {"ok": False, "error": f"real bot unreachable: {e}"}


# --- the dashboard copy --------------------------------------------------------

def stand_in_trader(tmp: Path, fixture: Path = None) -> Path:
    """A trader checkout that only prints the fixture: .venv/bin/python3 is a
    shell script that cats it, whatever it is asked to run."""
    root = tmp / "trader-standin"
    (root / ".venv" / "bin").mkdir(parents=True, exist_ok=True)
    (root / "scripts").mkdir(exist_ok=True)
    (root / "scripts" / "trader_status.py").write_text("# stand-in: see .venv/bin/python3\n")
    py = root / ".venv" / "bin" / "python3"
    py.write_text(f"#!/bin/sh\nexec cat '{fixture or TRADER_FIXTURE}'\n")
    py.chmod(0o755)
    return root


def trader_projects(home: Path, tmp: Path, live: bool) -> None:
    """The copy's projects.json: only the trader project, at the stand-in
    (or, live, at the real checkout the live projects.json names)."""
    cwd = ""
    if live:
        try:
            cwd = json.loads((home / "projects.json").read_text())["trader"]["scope"]["cwd"]
        except (OSError, ValueError, KeyError, TypeError):
            raise SystemExit("--trader-live: no trader project with a cwd in projects.json")
    else:
        cwd = str(stand_in_trader(tmp))
    (tmp / "projects.json").write_text(json.dumps(
        {"trader": {"slug": "trader", "title": "Trader", "scope": {"cwd": cwd}}}))


PROBE_JS = REPO / "bin" / "scrollprobe.js"
PERF_JS = REPO / "bin" / "perfprobe.js"


def inject_probe(viz: Path, bot_port: int, probe_js: Path = PROBE_JS) -> None:
    """The copy's page runs a probe -- bin/scrollprobe.js, or with --perf
    bin/perfprobe.js -- ahead of its own script (each does nothing unless the
    address asks for it: ?probe= or ?perf=)."""
    src = viz.read_text()
    marker = "\n<script>\n"
    at = src.index("PAGE = r\"\"\"")
    i = src.index(marker, at)
    js = probe_js.read_text().replace("__BOT__", f"http://127.0.0.1:{bot_port}")
    assert '"""' not in js
    viz.write_text(src[:i] + "\n<script>" + js + "</script>" + src[i:])


#: --deploy's revision label, and its draft: with ?shotsdraft=1 (read before the
#: page's own script takes the query off the address bar) words are typed into
#: the composer once the thread has opened. Inline, before the page's script.
DEPLOY_JS = """(function () {
  const label = "__LABEL__";
  const draft = /[?&]shotsdraft=1/.test(location.search);
  addEventListener("DOMContentLoaded", () => {
    const d = document.createElement("div");
    d.id = "shotsrev";
    d.textContent = "page code: " + label;
    d.style.cssText = "position:fixed;left:12px;bottom:140px;z-index:2147483647;"
      + "background:#c0262d;color:#fff;font:700 20px -apple-system,sans-serif;"
      + "padding:8px 12px;border-radius:10px;pointer-events:none";
    document.body.appendChild(d);
    if (draft) setTimeout(() => {
      const b = document.getElementById("reply");
      if (b) { b.value = "A draft typed before the deploy"; b.dispatchEvent(new Event("input")); }
    }, 2500);
    // The simulator has no taps: once an update banner has been up for
    // __TAPMS__ms (after the harness photographs it), it is tapped here.
    if (draft) {
      let seen = 0;
      setInterval(() => {
        const bar = document.getElementById("updbar");
        if (!bar || !bar.classList.contains("on")) return;
        if (!seen) seen = Date.now();
        else if (Date.now() - seen >= __TAPMS__ && !bar.dataset.tapped) { bar.dataset.tapped = 1; bar.click(); }
      }, 250);
    }
  });
})();"""


def inject_label(viz: Path, label: str, tap_ms: int = 8000) -> None:
    """The copy's page shows `label` and can type a draft (DEPLOY_JS). The
    page's text changes with the label, so each label is its own revision."""
    src = viz.read_text()
    marker = "\n<script>\n"
    i = src.index(marker, src.index("PAGE = r\"\"\""))
    viz.write_text(src[:i] + "\n<script>" + DEPLOY_JS.replace("__LABEL__", label).replace("__TAPMS__", str(tap_ms))
                   + "</script>" + src[i:])


def start_dashboard(source: Path, home: Path, tmp: Path, bot_port: int, port: int,
                    trader_live: bool = False, probe: bool = False, label: str = "",
                    tap_ms: int = 8000):
    trader_projects(home, tmp, trader_live)
    for f in source.glob("*.py"):
        shutil.copy2(f, tmp / f.name)
    if probe:
        inject_probe(tmp / "visualizer.py", bot_port, probe if isinstance(probe, Path) else PROBE_JS)
    if label:
        inject_label(tmp / "visualizer.py", label, tap_ms)
    if (source / "assets").is_dir():
        shutil.copytree(source / "assets", tmp / "assets")
    # operator.json: whose thread the list pins (the operator's home).
    # tasks.json: what search finds tasks in (visualizer.SearchIndex).
    for name in ("sessions.json", "operator.json", "tasks.json"):
        if (home / name).exists():
            shutil.copy2(home / name, tmp / name)
    own_turn(tmp / "sessions.json")
    seed_seen(home, tmp)
    (tmp / ".env").write_text(f"APPROVAL_PORT={bot_port}\n")
    env = {k: v for k, v in os.environ.items()
           if not k.startswith(("VIZ_", "SILKWORM_"))}
    env["SILKWORM_VIZ_PORT"] = str(port)
    py = home / ".venv" / "bin" / "python"
    proc = subprocess.Popen([str(py if py.exists() else sys.executable), "visualizer.py"],
                            cwd=tmp, env=env, stdout=subprocess.DEVNULL,
                            stderr=open(tmp / "viz.log", "w"))
    for _ in range(100):
        try:
            urllib.request.urlopen(f"http://127.0.0.1:{port}/", timeout=1).read()
            return proc
        except Exception:
            if proc.poll() is not None:
                raise SystemExit("dashboard copy died:\n" + (tmp / "viz.log").read_text())
            time.sleep(0.1)
    raise SystemExit("dashboard copy never answered")


#: With no seen.json yet (unread tracking starts when one is first made, so
#: every reply before it is read), the copy's starts this long ago instead:
#: the photographed list has the last day's replies to show as unread.
SEEN_SEED_S = 86400


def seed_seen(home: Path, tmp: Path) -> None:
    """The copy's read state (unread.py): the owner's own, copied, or one
    begun SEEN_SEED_S ago. The real one is never written."""
    if (home / "seen.json").exists():
        shutil.copy2(home / "seen.json", tmp / "seen.json")
    else:
        (tmp / "seen.json").write_text(json.dumps({"since": time.time() - SEEN_SEED_S, "threads": {}}))


def own_turn(sessions: Path) -> None:
    """Run from inside a Silkworm turn, the copy's marker for that turn gets
    the turn's session id when the bot has not recorded one, so the running
    turn the harness photographs is this one, live: its transcript, and its
    claude process found alive. Only the copy is touched."""
    key, sid = os.environ.get("SILKWORM_THREAD", ""), os.environ.get("CLAUDE_CODE_SESSION_ID", "")
    if not (key and sid and sessions.exists()):
        return
    data = json.loads(sessions.read_text())
    pending = (data.get(key) or {}).get("pending")
    if isinstance(pending, dict) and not pending.get("session_id"):
        pending["session_id"] = sid
        sessions.write_text(json.dumps(data))


# --- what to shoot ------------------------------------------------------------

def get_json(url: str, payload=None):
    data = json.dumps(payload).encode() if payload is not None else None
    req = urllib.request.Request(url, data=data, method="POST" if data else "GET",
                                 headers={"Content-Type": "application/json"})
    with urllib.request.urlopen(req, timeout=20) as r:
        return json.loads(r.read())


def pick_examples(base: str, project: str) -> dict:
    """A long conversation and a task with a review, from the copy's own data."""
    out = {"thread": "", "card": "", "task": ""}
    try:
        sys.path.insert(0, str(REPO))
        import operator_role
        out["operator"] = operator_role.State(live_home() / "operator.json", readonly=True).thread()
    except Exception:
        out["operator"] = ""
    sessions = get_json(base + "/api/sessions").get("sessions", [])
    convs = [s for s in sessions if (s.get("kind") or "thread") == "thread"
             and not s.get("hidden") and s.get("turns", 0) > 2]
    if convs:
        out["thread"] = max(convs, key=lambda s: s.get("updated", 0))["key"]
    # The thread with the most files, for its inline attachments and drawer.
    filed = [s for s in sessions if not s.get("hidden") and s.get("files", 0) > 0]
    if filed:
        out["files"] = max(filed, key=lambda s: (s.get("files", 0), s.get("updated", 0)))["key"]
    # A turn in progress: the harness's own thread when a Silkworm turn runs
    # it (that turn is running while it shoots), else any live one.
    running = [s for s in sessions if s.get("turn") and not s["turn"].get("stalled")]
    mine = os.environ.get("SILKWORM_THREAD", "")
    if running:
        out["running"] = next((s["key"] for s in running if s["key"] == mine), running[0]["key"])
    board = get_json(base + "/api/tasks", {"action": "board", "project": project})
    cards = [t for col in (board.get("columns") or {}).values() for t in col]
    cards.sort(key=lambda t: (bool(t.get("review")), t.get("created", 0)), reverse=True)
    if cards:
        out["card"] = cards[0]["id"]
    # ?task= opens the task panel on a row that needs you, so pick one that does.
    needs = get_json(base + "/api/tasks", {"action": "attention"}).get("tasks") or []
    out["task"] = needs[0]["id"] if needs else out["card"]
    # A landed task with a reply, for the task page's result, changes and
    # timeline -- one whose thread holds images, if any does.
    try:
        tasks_ = json.loads((live_home() / "tasks.json").read_text())
        raw = json.loads((live_home() / "sessions.json").read_text())
        raw = raw.get("sessions", raw) if isinstance(raw, dict) else {}

        def images(t):
            # As the page picks them (taskImages): Claude's, from when it ran.
            at = t.get("created") or 0
            return sum(1 for f in (raw.get(t.get("thread") or "") or {}).get("files") or []
                       if f.get("direction") != "in" and (f.get("ts") or 0) >= at - 60
                       and str(f.get("path") or "").lower().endswith((".png", ".jpg", ".jpeg")))
        landed = [t for t in tasks_.values() if ((t.get("result") or {}).get("landing") or {}).get("landed")
                  and (t.get("result") or {}).get("text") and t.get("role") != "reviewer"]
        landed.sort(key=lambda t: (images(t) > 0, t.get("updated") or 0))
        if landed:
            out["landed"] = landed[-1]["id"]
    except Exception:
        pass
    # An app (one with App Store checks), for the project page's store section.
    try:
        sys.path.insert(0, str(REPO))
        import health
        rows = health.HealthStore(live_home() / "health.json", readonly=True).all()
        apps = sorted({r.get("project") for r in rows if r.get("check") in ("app-store", "testflight")
                       and r.get("project") and r.get("project") != project})
        if apps:
            out["app"] = apps[0]
    except Exception:
        pass
    return out


def views(ex: dict, project: str) -> list[tuple[str, str]]:
    p = quote(project)
    return [
        # The home screen: Needs you (inbox.py), on a phone its first tab.
        ("inbox", "/"),
        ("sessions", "/?view=threads"),
        ("sessions-unread", "/?list=unread"),
        ("stats", "/?view=stats"),
        ("thread", f"/?thread={quote(ex['thread'])}"),
        # The operator's thread, with the sample plan's card (DASHSHOTS_PLAN).
        *([("thread-plan", f"/?thread={quote(ex['operator'])}")] if ex.get("operator") else []),
        *([("thread-running", f"/?thread={quote(ex['running'])}")] if ex.get("running") else []),
        # The thread's longest turn, its one tools line opened onto the chain.
        ("thread-tools", f"/?thread={quote(ex['thread'])}&tools=open"),
        *([("thread-files", f"/?thread={quote(ex['files'])}&files=1"),
           ("thread-drawer", f"/?thread={quote(ex['files'])}&drawer=1")] if ex.get("files") else []),
        # A thread with no session yet is what a new thread is until its first
        # turn writes: the page draws it from the key alone.
        ("thread-new", f"/?thread={quote(NEW_THREAD)}"),
        ("search", "/?q=" + quote("tailscale")),
        # A task id's first characters: the id match first, then mentions.
        ("search-id", "/?q=" + quote(ex["task"][:9])),
        ("new-thread", "/?modal=new-thread"),
        ("alerts", "/?modal=alerts"),
        ("tasks", "/?view=tasks"),
        ("tasks-all", "/?view=tasks&tab=all"),
        ("task", f"/?task={quote(ex['task'])}"),
        *([("task-page", f"/?task={quote(ex['landed'])}"),
           ("task-page-changes", f"/?task={quote(ex['landed'])}&sec=changes"),
           ("task-page-timeline", f"/?task={quote(ex['landed'])}&sec=timeline")] if ex.get("landed") else []),
        ("projects", "/?view=projects"),
        # A project's own page (board.project_page), and an app's.
        ("project", f"/?view=project&slug={p}"),
        *([("project-app", f"/?view=project&slug={quote(ex['app'])}"),
           ("project-app-store", f"/?view=project&slug={quote(ex['app'])}&sec=app")] if ex.get("app") else []),
        ("project-lower", f"/?view=project&slug={p}&sec=health"),
        ("board", f"/?view=board&slug={p}"),
        ("card", f"/?view=board&slug={p}&card={quote(ex['card'])}"),
        ("new-task", f"/?view=board&slug={p}&modal=new-task"),
        ("settings", f"/?view=projects&modal=settings&slug={p}"),
        ("new-project", "/?modal=new-project"),
        ("release", f"/?view=projects&modal=release&slug={p}"),
        ("learnings", "/?view=learnings"),
        ("trader", "/?view=trader"),
        ("trader-sleeves", "/?view=trader&tab=sleeves"),
        ("trader-activity", "/?view=trader&tab=activity"),
        ("trader-plumbing", "/?view=trader&tab=plumbing"),
        ("trader-shadow", "/?view=trader&tab=shadow"),
        # The light theme (⋯ › Theme), a list, a thread and a board in it.
        ("light-inbox", "/?theme=light"),
        ("light-sessions", "/?view=threads&theme=light"),
        ("light-thread", f"/?thread={quote(ex['thread'])}&theme=light"),
        ("light-board", f"/?view=board&slug={p}&theme=light"),
        ("light-project", f"/?view=project&slug={p}&theme=light"),
        *([("light-task-page", f"/?task={quote(ex['landed'])}&theme=light")] if ex.get("landed") else []),
    ]


# --- simulators ----------------------------------------------------------------

def simctl(*args, check=True, capture=True):
    r = subprocess.run(["xcrun", "simctl", *args], capture_output=capture, text=True)
    if check and r.returncode:
        raise SystemExit(f"simctl {' '.join(args)}: {r.stderr.strip()}")
    return r.stdout if capture else ""


def device_for(width: int) -> str:
    name, kind = DEVICES[width]
    assert name not in FORBIDDEN_DEVICES
    listing = json.loads(simctl("list", "devices", "-j"))
    for runtime, devs in listing["devices"].items():
        for d in devs:
            if d["name"] == name and d.get("isAvailable", True):
                return d["udid"]
    runtimes = [r for r in json.loads(simctl("list", "runtimes", "-j"))["runtimes"]
                if r.get("isAvailable") and r["identifier"].startswith(
                    "com.apple.CoreSimulator.SimRuntime.iOS")]
    if not runtimes:
        raise SystemExit("no iOS simulator runtime installed")
    rt = max(runtimes, key=lambda r: [int(x) for x in r["version"].split(".")])
    types = json.loads(simctl("list", "devicetypes", "-j"))["devicetypes"]
    t = next(x for x in types if x["name"] == kind)
    return simctl("create", name, t["identifier"], rt["identifier"]).strip()


def shoot_phone(width: int, targets, shots, out: Path, wait: float):
    udid = device_for(width)
    name = DEVICES[width][0]
    print(f"  {name} ({udid})")
    state = json.loads(simctl("list", "devices", "-j"))
    booted_before = any(d["udid"] == udid and d["state"] == "Booted"
                        for devs in state["devices"].values() for d in devs)
    try:
        if not booted_before:
            simctl("boot", udid)
        simctl("bootstatus", udid, "-b")
        simctl("ui", udid, "appearance", "dark", check=False)
        # Safari's first open of a page is slow on a fresh boot.
        for _, base in targets:
            simctl("openurl", udid, base + "/")
            time.sleep(wait * 2)
        for view, path in shots:
            for suffix, base in targets:
                simctl("openurl", udid, base + path)
                time.sleep(wait)
                simctl("io", udid, "screenshot", str(out / f"{view}-{width}{suffix}.png"))
                print(f"    {view}-{width}{suffix}.png")
    finally:
        simctl("shutdown", udid, check=False)


def probe_phone(width: int, targets, out: Path, runs: str, timeout: float = 600):
    """Each target's page runs the scroll probe in Mobile Safari; every phase
    it reports is photographed (a burst of frames right after a trigger), and
    what it measured is written to out/probe-<width><suffix>.json."""
    udid = device_for(width)
    print(f"  {DEVICES[width][0]} ({udid})")
    state = json.loads(simctl("list", "devices", "-j"))
    booted_before = any(d["udid"] == udid and d["state"] == "Booted"
                        for devs in state["devices"].values() for d in devs)
    results = {}
    try:
        if not booted_before:
            simctl("boot", udid)
        simctl("bootstatus", udid, "-b")
        simctl("ui", udid, "appearance", "dark", check=False)
        for suffix, base in targets:
            simctl("openurl", udid, base + "/")
            time.sleep(8)
        for suffix, base in targets:
            PROBE.reset()
            frames = out / f"frames-{width}{suffix}"
            frames.mkdir(parents=True, exist_ok=True)
            url = base + "/?probe=1" + (f"&runs={quote(runs)}" if runs else "")
            simctl("openurl", udid, url)
            seen, done, t0, rows = 0, False, time.time(), []
            while not done and time.time() - t0 < timeout:
                with PROBE.lock:
                    new = PROBE.log[seen:]
                    seen = len(PROBE.log)
                for e in new:
                    ph = e.get("phase")
                    if ph in ("done", "error"):
                        done = True
                        if ph == "error":
                            print("    probe error:", e.get("error"))
                    if ph == "start":
                        print(f"    {suffix or 'page'}: visualViewport stubbed={e.get('stubbed')} "
                              f"keyboard={e.get('kb')}px innerHeight={e.get('inner')}")
                    if "step" not in e:
                        continue
                    tag = f"{e.get('run', 'x')}-{e.get('mode', '')}"
                    if ph == "burst":
                        for k in range(4):
                            simctl("io", udid, "screenshot", str(frames / f"{tag}-{k + 1}.png"))
                    else:
                        simctl("io", udid, "screenshot", str(frames / f"{tag}-{ph}.png"))
                    if ph == "after":
                        rows.append(e)
                        print(f"    {'ok  ' if e.get('ok') else 'JUMP'} {e['run']:20} {e['mode']:6} "
                              f"shift={e.get('shift')} gap {e['before']['gap']}->{e['after']['gap']} "
                              f"latest visible {e['before']['lastVisible']}->{e['after']['lastVisible']}")
                    with PROBE.lock:
                        PROBE.go = e["step"]
                time.sleep(0.1)
            if not done:
                print("    probe timed out")
            results[suffix or "page"] = rows
            (out / f"probe-{width}{suffix}.json").write_text(json.dumps(rows, indent=1))
    finally:
        simctl("shutdown", udid, check=False)
    return results


def perf_phone(width: int, targets, out: Path, runs: int = 3, timeout: float = 180):
    """Each target's page runs the performance probe in Mobile Safari `runs`
    times, alternating targets so neither always goes first; what it measured
    is written to out/perf-<width>.json, every run kept."""
    udid = device_for(width)
    print(f"  {DEVICES[width][0]} ({udid})")
    state = json.loads(simctl("list", "devices", "-j"))
    booted_before = any(d["udid"] == udid and d["state"] == "Booted"
                        for devs in state["devices"].values() for d in devs)
    results = {suffix or "page": [] for suffix, _ in targets}
    try:
        if not booted_before:
            simctl("boot", udid)
        simctl("bootstatus", udid, "-b")
        simctl("ui", udid, "appearance", "dark", check=False)
        for _, base in targets:                 # Safari's first open is slow on a fresh boot
            simctl("openurl", udid, base + "/")
            time.sleep(8)
        for n in range(runs):
            for suffix, base in targets:
                PROBE.reset()
                simctl("openurl", udid, f"{base}/?perf=1&n={n}")
                t0, got = time.time(), None
                while time.time() - t0 < timeout:
                    with PROBE.lock:
                        log = list(PROBE.log)
                    if any(e.get("phase") in ("done", "error") for e in log):
                        got = next((e for e in log if e.get("phase") == "perf"), None)
                        err = next((e for e in log if e.get("phase") == "error"), None)
                        if err:
                            print("    probe error:", err.get("error"))
                        break
                    time.sleep(0.25)
                results[suffix or "page"].append(got)
                if got:
                    print(f"    {suffix or 'page'} run {n + 1}: list drawn {got.get('list_drawn_ms')}ms, "
                          f"fcp {got.get('paint', {}).get('first-contentful-paint')}ms, "
                          + ", ".join(f"{k} {v.get('fps')}fps/p95 {v.get('p95_ms')}ms"
                                      for k, v in got.items() if isinstance(v, dict) and "fps" in v))
                else:
                    print(f"    {suffix or 'page'} run {n + 1}: no answer")
        (out / f"perf-{width}.json").write_text(json.dumps(results, indent=1))
    finally:
        simctl("shutdown", udid, check=False)
    return results


def deploy_phone(width: int, old: Path, new: Path, home: Path, tmp: Path, bot_port: int,
                 out: Path, wait: float, trader_live: bool = False):
    """A deploy while the app is open (see --deploy): open on rev A,
    background, swap the server to rev B on the same port, resume, shoot."""
    udid = device_for(width)
    print(f"  {DEVICES[width][0]} ({udid})")
    state = json.loads(simctl("list", "devices", "-j"))
    booted_before = any(d["udid"] == udid and d["state"] == "Booted"
                        for devs in state["devices"].values() for d in devs)
    try:
        if not booted_before:
            simctl("boot", udid)
        simctl("bootstatus", udid, "-b")
        simctl("ui", udid, "appearance", "dark", check=False)
        for run, path in (("plain", "/"), ("draft", f"/?thread={quote(NEW_THREAD)}&shotsdraft=1")):
            port = free_port()
            base = f"http://127.0.0.1:{port}"
            a_tmp, b_tmp = tmp / f"deploy-{width}-{run}-a", tmp / f"deploy-{width}-{run}-b"
            a_tmp.mkdir(); b_tmp.mkdir()
            # Rev A's banner is tapped once it has been up 1.6 waits: after the
            # resumed photograph, before the tapped one.
            a = start_dashboard(old, home, a_tmp, bot_port, port, trader_live, label="rev A",
                                tap_ms=int(wait * 1600))
            b = None
            try:
                simctl("openurl", udid, base + path)
                time.sleep(wait * 2)
                shot = lambda step: (simctl("io", udid, "screenshot", str(
                    out / f"deploy-{width}-{run}-{step}.png")), print(f"    deploy-{width}-{run}-{step}.png"))
                shot("1-open")
                # Away, as the phone's app switcher leaves it: suspended, not closed.
                simctl("launch", udid, "com.apple.Preferences")
                time.sleep(2)
                a.terminate(); a.wait(timeout=10)
                b = start_dashboard(new, home, b_tmp, bot_port, port, trader_live, label="rev B")
                # Back: the same tab, resumed. No navigation is made here.
                simctl("launch", udid, "com.apple.mobilesafari")
                time.sleep(wait)
                shot("2-resumed")
                if run == "draft":
                    time.sleep(wait * 2)
                    shot("2b-banner-tapped")
                simctl("openurl", udid, base + "/")
                time.sleep(wait)
                shot("3-fresh")
            finally:
                for pr in (a, b):
                    if pr is not None and pr.poll() is None:
                        pr.terminate()
    finally:
        simctl("shutdown", udid, check=False)


def snapper(tmp: Path) -> Path:
    cache = Path.home() / ".cache" / "silkworm-dashshots"
    cache.mkdir(parents=True, exist_ok=True)
    exe = cache / "websnap"
    if not exe.exists() or exe.stat().st_mtime < SWIFT_SRC.stat().st_mtime:
        r = subprocess.run(["swiftc", "-O", str(SWIFT_SRC), "-o", str(exe)],
                           capture_output=True, text=True)
        if r.returncode:
            raise SystemExit("swiftc websnap failed:\n" + r.stderr)
    return exe


def shoot_desktop(targets, shots, out: Path, wait: float, tmp: Path):
    exe = snapper(tmp)
    for view, path in shots:
        for suffix, base in targets:
            dest = out / f"{view}-{DESKTOP}{suffix}.png"
            r = subprocess.run([str(exe), base + path, str(dest), str(DESKTOP), "860", str(wait)],
                               capture_output=True, text=True, timeout=120)
            print(f"    {dest.name}" + ("" if r.returncode == 0 else f"  FAILED {r.stdout}{r.stderr}"))


def main():
    ap = argparse.ArgumentParser(description=__doc__.split("\n\n")[0])
    ap.add_argument("--out", default=str(REPO / "artifacts" / "dashshots"))
    ap.add_argument("--views", default="")
    ap.add_argument("--widths", default="375,430,1280")
    ap.add_argument("--source", default=str(REPO), help="checkout whose visualizer.py is shot")
    ap.add_argument("--before", default="",
                    help="also shoot this checkout's visualizer.py, each view right before --source's")
    ap.add_argument("--project", default="silkworm")
    ap.add_argument("--wait", type=float, default=5.0, help="seconds per view to settle")
    ap.add_argument("--list", action="store_true", help="print the views and exit")
    ap.add_argument("--trader-fixture", default="",
                    help="the status document the trader views draw (default: the real-shape capture)")
    ap.add_argument("--scroll-probe", action="store_true",
                    help="run the chat's scroll probe (bin/scrollprobe.js) on the phone widths "
                         "instead of shooting views")
    ap.add_argument("--runs", default="", help="with --scroll-probe: only these triggers")
    ap.add_argument("--perf", action="store_true",
                    help="measure first paint and scroll/sheet frame rates (bin/perfprobe.js) on the "
                         "phone widths instead of shooting views; with --before, both, alternating")
    ap.add_argument("--perf-runs", type=int, default=3, help="with --perf: runs per target")
    ap.add_argument("--deploy", action="store_true",
                    help="photograph a deploy landing while the app is open (phone widths)")
    ap.add_argument("--deploy-from", default="",
                    help="with --deploy: the checkout the app is open on before it (default --source)")
    ap.add_argument("--trader-live", action="store_true",
                    help="draw the trader view from the real trader checkout, not the fixture")
    a = ap.parse_args()
    if a.trader_fixture:
        global TRADER_FIXTURE
        TRADER_FIXTURE = Path(a.trader_fixture).resolve()

    home = live_home()
    real_port = env_value(home / ".env", "APPROVAL_PORT") or "8787"
    out = Path(a.out)
    out.mkdir(parents=True, exist_ok=True)
    with tempfile.TemporaryDirectory(prefix="dashshots-") as td:
        tmp = Path(td)
        bot_port = free_port()
        bot = ThreadingHTTPServer(("127.0.0.1", bot_port), stand_in(real_port))
        threading.Thread(target=bot.serve_forever, daemon=True).start()
        if a.deploy:
            print(f"deploy: {a.deploy_from or a.source} -> {a.source} while open -> {out}")
            try:
                for w in [int(x) for x in a.widths.split(",") if x and int(x) in DEVICES]:
                    deploy_phone(w, Path(a.deploy_from or a.source).resolve(),
                                 Path(a.source).resolve(), home, tmp, bot_port, out, a.wait,
                                 a.trader_live)
            finally:
                bot.shutdown()
            return
        port = free_port()
        proc = start_dashboard(Path(a.source).resolve(), home, tmp, bot_port, port, a.trader_live,
                               PERF_JS if a.perf else a.scroll_probe)
        base = f"http://127.0.0.1:{port}"
        procs, targets = [proc], [("", base)]
        try:
            if a.before:
                btmp = tmp / "before"
                btmp.mkdir()
                bport = free_port()
                procs.append(start_dashboard(Path(a.before).resolve(), home, btmp, bot_port, bport,
                                             a.trader_live, PERF_JS if a.perf else a.scroll_probe))
                targets = [("-before", f"http://127.0.0.1:{bport}"), ("-after", base)]
            if a.perf:
                print(f"perf probe: dashboard copy at {base} (stand-in bot :{bot_port}) -> {out}")
                for w in [int(x) for x in a.widths.split(",") if x and int(x) in DEVICES]:
                    perf_phone(w, targets, out, a.perf_runs)
                return
            if a.scroll_probe:
                print(f"scroll probe: dashboard copy at {base} (stand-in bot :{bot_port}) -> {out}")
                for w in [int(x) for x in a.widths.split(",") if x and int(x) in DEVICES]:
                    probe_phone(w, targets, out, a.runs)
                return
            ex = pick_examples(base, a.project)
            shots = views(ex, a.project)
            if a.views:
                want = set(a.views.split(","))
                shots = [s for s in shots if s[0] in want]
            if a.list:
                for v, p in shots:
                    print(f"{v:12} {p}")
                return
            print(f"dashboard copy at {base} (stand-in bot :{bot_port}) -> {out}")
            for w in [int(x) for x in a.widths.split(",") if x]:
                if w == DESKTOP:
                    print(f"  desktop {DESKTOP}px (WKWebView)")
                    shoot_desktop(targets, shots, out, a.wait, tmp)
                elif w in DEVICES:
                    shoot_phone(w, targets, shots, out, a.wait)
                else:
                    raise SystemExit(f"no device for width {w}; use {sorted(DEVICES)} or {DESKTOP}")
        finally:
            for pr in procs:
                pr.terminate()
            bot.shutdown()


if __name__ == "__main__":
    main()
